index 5feac4e..0b5ebfc 100644
--- a/bsd/dev/beryllium_adsp.c
+++ b/bsd/dev/beryllium_adsp.c
@@ -2303,19 +2303,70 @@ struct adsp_apr_channel_state {
 	uint32_t expected_write_sequence;
 };
 
+static bool
+adsp_glink_tx_indices_snapshot(uint32_t descriptor_off,
+	struct beryllium_adsp_glink_indices *first,
+	struct beryllium_adsp_glink_indices *second)
+{
+	if (first == NULL || second == NULL) {
+		return false;
+	}
+	__asm__ volatile ("dmb sy" ::: "memory");
+	first->tx_tail = adsp_smem_rd32(descriptor_off);
+	first->tx_head = adsp_smem_rd32(descriptor_off + 4);
+	first->rx_tail = adsp_smem_rd32(descriptor_off + 8);
+	first->rx_head = adsp_smem_rd32(descriptor_off + 12);
+	__asm__ volatile ("dmb sy" ::: "memory");
+	second->tx_tail = adsp_smem_rd32(descriptor_off);
+	second->tx_head = adsp_smem_rd32(descriptor_off + 4);
+	second->rx_tail = adsp_smem_rd32(descriptor_off + 8);
+	second->rx_head = adsp_smem_rd32(descriptor_off + 12);
+	__asm__ volatile ("dmb sy" ::: "memory");
+	return true;
+}
+
 static bool
 adsp_glink_send_frame(const struct adsp_glink_survey_items *items,
