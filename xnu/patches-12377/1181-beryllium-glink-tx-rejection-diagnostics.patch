-	    !adsp_glink_start_items_valid(items, true) ||
-	    !adsp_glink_survey_read_indices(items->descriptor.off, &indices) ||
-	    !beryllium_adsp_glink_indices_valid(&indices,
+	if (items == NULL) {
+		printf("SWEET ADSP: APR GLINK TX stopped: null survey items\n");
+		return false;
+	}
+	if (frame == NULL || frame_bytes == 0 ||
+	    frame_bytes > ADSP_APR_GLINK_FRAME_MAX) {
+		printf("SWEET ADSP: APR GLINK TX stopped: invalid frame length/pointer bytes=%lu limit=%u\n",
+		    (unsigned long)frame_bytes, ADSP_APR_GLINK_FRAME_MAX);
+		return false;
+	}
+	if (!adsp_glink_start_items_valid(items, true)) {
+		printf("SWEET ADSP: APR GLINK TX stopped: item validation failed descriptor=%d/%#x+%#x tx=%d/%#x+%#x rx=%d/%#x+%#x\n",
+		    items->descriptor.result, items->descriptor.off,
+		    items->descriptor.size, items->tx_fifo.result,
+		    items->tx_fifo.off, items->tx_fifo.size, items->rx_fifo.result,
+		    items->rx_fifo.off, items->rx_fifo.size);
+		return false;
+	}
+	if (!adsp_glink_tx_indices_snapshot(items->descriptor.off,
+	    &first, &second)) {
+		printf("SWEET ADSP: APR GLINK TX stopped: descriptor index sample read failed\n");
