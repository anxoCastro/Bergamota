+
+int
+sweet_gic_spi_config_snapshot(unsigned int intid, uint32_t *group, uint32_t *modifier,
+    uint32_t *trigger, uint32_t *dist_ctlr, uint32_t *dist_group1_enabled,
+    uint64_t *cpu_igrpen1, uint64_t *route, uint64_t *mpidr)
+{
+	if (!gicd_base || intid < 32 || intid >= 1020 || group == NULL || modifier == NULL ||
+	    trigger == NULL || dist_ctlr == NULL || dist_group1_enabled == NULL ||
+	    cpu_igrpen1 == NULL || route == NULL || mpidr == NULL) {
+		return 0;
+	}
+	uint32_t offset = (intid / 32u) * sizeof(uint32_t);
+	uint32_t mask = 1u << (intid % 32u);
+	uint32_t config_offset = 0xC00u + (intid / 16u) * sizeof(uint32_t);
+	uint32_t config_shift = (intid % 16u) * 2u;
+	*group = (gicd_read32(0x080u + offset) & mask) != 0;
+	*modifier = (gicd_read32(0xD00u + offset) & mask) != 0;
+	*trigger = (gicd_read32(config_offset) >> config_shift) & 3u;
+	*dist_ctlr = gicd_read32(GICD_CTLR);
+	*dist_group1_enabled = (*dist_ctlr & GICD_CTLR_ENABLEGRP1) != 0;
+	*cpu_igrpen1 = __builtin_arm_rsr64("ICC_IGRPEN1_EL1");
+	/* Linux uses GICD_IROUTER + INTID * 8; SPI 32 is at 0x6100. */
+	*route = gicd_read64(0x6000u + (uint64_t)intid * sizeof(uint64_t));
+	*mpidr = __builtin_arm_rsr64("MPIDR_EL1");
 	return 1;
 }
 
