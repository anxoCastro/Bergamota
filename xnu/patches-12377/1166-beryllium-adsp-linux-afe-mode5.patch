 static bool
+adsp_apr_send_afe_packet(const struct adsp_glink_survey_items *items,
+	struct adsp_apr_channel_state *state, const uint8_t *packet,
+	size_t packet_bytes, uint32_t request_opcode)
+{
+	uint8_t frame[16 + BERYLLIUM_ADSP_APR_MAX_DATA_BYTES] = { 0 };
+	const struct beryllium_adsp_glink_intent *selected = NULL;
+	if (items == NULL || state == NULL || packet == NULL ||
+	    packet_bytes < BERYLLIUM_ADSP_APR_HEADER_BYTES ||
+	    packet_bytes > BERYLLIUM_ADSP_APR_MAX_DATA_BYTES ||
+	    beryllium_adsp_apr_get32(packet + 16) != request_opcode ||
+	    !state->request_intent_reusable) {
+		printf("SWEET ADSP: Linux AFE command stopped; request or reusable intent invalid\n");
+		return false;
+	}
+	for (size_t i = 0; i < state->remote_intent_count; i++) {
+		const struct beryllium_adsp_glink_intent *candidate =
+		    &state->remote_intents[i];
+		if (candidate->id != state->request_intent_id ||
+		    candidate->size < packet_bytes) {
+			continue;
+		}
+		selected = candidate;
+		break;
+	}
+	if (selected == NULL) {
+		printf("SWEET ADSP: Linux AFE command stopped; reusable remote intent is too small\n");
+		return false;
+	}
+	state->request_intent_id = selected->id;
+	state->request_opcode = request_opcode;
+	state->request_intent_reusable = false;
+	state->response_status_valid = false;
+	beryllium_adsp_apr_put16(frame, BERYLLIUM_ADSP_GLINK_CMD_TX_DATA);
+	beryllium_adsp_apr_put16(frame + 2, ADSP_APR_LOCAL_CHANNEL);
+	beryllium_adsp_apr_put32(frame + 4, selected->id);
+	beryllium_adsp_apr_put32(frame + 8, (uint32_t)packet_bytes);
+	beryllium_adsp_apr_put32(frame + 12, 0);
+	for (size_t i = 0; i < packet_bytes; i++) {
+		frame[16 + i] = packet[i];
+	}
+	if (!adsp_glink_send_frame(items, frame, 16 + packet_bytes)) {
+		printf("SWEET ADSP: Linux AFE command GLINK TX failed opcode=%#x\n",
+		    request_opcode);
+		return false;
+	}
+	printf("SWEET ADSP: sent Linux AFE command opcode=%#x bytes=%lu port=%#x intent=%u\n",
+	    request_opcode, (unsigned long)packet_bytes,
+	    BERYLLIUM_ADSP_AFE_PORT_QUAT_MI2S_RX, selected->id);
+	return true;
+}
