+static bool
+adsp_apr_linux_afe_command(const struct adsp_glink_survey_items *items,
+	struct adsp_apr_channel_state *state, const uint8_t *packet,
+	size_t packet_bytes, uint32_t request_opcode, const char *label)
+{
+	if (!adsp_apr_send_afe_packet(items, state, packet, packet_bytes,
+	    request_opcode)) {
+		return false;
+	}
+	if (!adsp_apr_poll_response(items, state)) {
+		printf("SWEET ADSP: Linux AFE %s response missing/invalid; stopping sequence\n",
+		    label);
+		return false;
+	}
+	if (!state->response_status_valid) {
+		printf("SWEET ADSP: Linux AFE %s response had no validated status; stopping sequence\n",
+		    label);
+		return false;
+	}
+	if (state->response_status != 0) {
+		printf("SWEET ADSP: Linux AFE %s rejected status=%#x; stopping sequence\n",
+		    label, state->response_status);
+		return false;
+	}
+	printf("SWEET ADSP: Linux AFE %s accepted status=0\n", label);
+	return true;
+}
