+static void
+adsp_apr_linux_afe_mode5_start(void)
+{
+	struct adsp_glink_survey_items items;
+	struct adsp_apr_channel_state state;
+	struct beryllium_adsp_glink_indices indices;
+	uint8_t packet[BERYLLIUM_ADSP_AFE_I2S_SET_PARAM_PACKET_BYTES] = { 0 };
+	size_t packet_bytes = 0;
+	bzero(&state, sizeof(state));
+	if (!sweet_board_beryllium() || !adsp_glink_survey_read_items(4, &items) ||
+	    !adsp_glink_start_items_valid(&items, true) ||
+	    !adsp_glink_survey_read_indices(items.descriptor.off, &indices) ||
+	    !beryllium_adsp_glink_indices_valid(&indices, items.tx_fifo.size, items.rx_fifo.size)) {
+		printf("SWEET ADSP: Linux AFE mode 5 stopped: post-negotiation GLINK metadata/indices invalid\n");
+		return;
+	}
+	bzero(adsp_apr_rx_buffers, sizeof(adsp_apr_rx_buffers));
+	if (!adsp_apr_open_channel(&items, &state)) {
+		printf("SWEET ADSP: Linux AFE mode 5 stopped before sending a Q6Core command\n");
+		return;
+	}
+	if (!adsp_apr_advertise_local_intents(&items) ||
+	    !adsp_apr_wait_remote_intent(&items, &state)) {
+		printf("SWEET ADSP: Linux AFE mode 5 stopped before sending a Q6Core command\n");
+		return;
+	}
+	if (!adsp_apr_send_fwk_version(&items, &state) ||
+	    !adsp_apr_poll_response(&items, &state)) {
+		printf("SWEET ADSP: Linux AFE mode 5 stopped without a validated Q6Core response\n");
+		return;
+	}
+	if (!state.afe_api_v2) {
+		printf("SWEET ADSP: Linux AFE mode 5 stopped; no unique AFE API 2.0 record\n");
+		return;
+	}
+	if (!beryllium_adsp_apr_encode_afe_clock_set(packet, sizeof(packet),
+	    &packet_bytes, true) ||
+	    !adsp_apr_linux_afe_command(&items, &state, packet, packet_bytes,
+	    BERYLLIUM_ADSP_AFE_CMD_SVC_SET_PARAM, "QUAT clock set")) {
+		return;
+	}
+	if (!beryllium_adsp_apr_encode_afe_i2s_set_param(packet, sizeof(packet),
+	    &packet_bytes) ||
+	    !adsp_apr_linux_afe_command(&items, &state, packet, packet_bytes,
+	    BERYLLIUM_ADSP_AFE_CMD_SET_PARAM_V2, "QUAT I2S config")) {
+		return;
+	}
+	if (!beryllium_adsp_apr_encode_afe_device_command(packet, sizeof(packet),
+	    &packet_bytes, true) ||
+	    !adsp_apr_linux_afe_command(&items, &state, packet, packet_bytes,
+	    BERYLLIUM_ADSP_AFE_CMD_DEVICE_START, "QUAT DEVICE_START")) {
+		return;
+	}
+	if (!beryllium_adsp_apr_encode_afe_device_command(packet, sizeof(packet),
+	    &packet_bytes, false) ||
+	    !adsp_apr_linux_afe_command(&items, &state, packet, packet_bytes,
+	    BERYLLIUM_ADSP_AFE_CMD_DEVICE_STOP, "QUAT DEVICE_STOP")) {
+		return;
+	}
+	printf("SWEET ADSP: Linux QUAT AFE lifecycle completed; no PCM/ASM/ADM/codec route was opened\n");
+}
