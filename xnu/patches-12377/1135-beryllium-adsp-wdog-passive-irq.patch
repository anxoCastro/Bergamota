+/* Enable one non-secure, edge-triggered Group 1 SPI for a passive observer. */
+int
+sweet_gic_spi_enable_group1_edge(unsigned int intid)
+{
+	if (!gicd_base || intid < 32 || intid >= 1020) {
+		return 0;
+	}
+	uint32_t offset = (intid / 32u) * sizeof(uint32_t);
+	uint32_t mask = 1u << (intid % 32u);
+	if ((gicd_read32(0x200u + offset) | gicd_read32(0x300u + offset)) & mask) {
+		return 0; /* Refuse a stale or active interrupt before enabling it. */
+	}
+	uint32_t group_offset = 0x080u + offset;
+	gicd_write32(group_offset, gicd_read32(group_offset) | mask);
+	uint32_t config_offset = 0xC00u + (intid / 16u) * sizeof(uint32_t);
+	uint32_t config_shift = (intid % 16u) * 2u;
+	uint32_t config = gicd_read32(config_offset);
+	config = (config & ~(3u << config_shift)) | (2u << config_shift); /* rising edge */
+	gicd_write32(config_offset, config);
+	uint32_t priority_offset = 0x400u + (intid & ~3u);
+	uint32_t priority_shift = (intid % 4u) * 8u;
+	uint32_t priority = gicd_read32(priority_offset);
+	priority = (priority & ~(0xFFu << priority_shift)) | (0xA0u << priority_shift);
+	gicd_write32(priority_offset, priority);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	gicd_write32(0x100u + offset, mask); /* GICD_ISENABLER is write-one-to-set. */
+	for (unsigned int i = 0; i < 1000000u; i++) {
+		if (!(gicd_read32(GICD_CTLR) & GICD_CTLR_RWP)) {
+			if (gicd_read32(0x100u + offset) & mask) {
+				return 1;
+			}
+			gicd_write32(0x180u + offset, mask); /* Roll back a rejected enable. */
+			__asm__ volatile ("dsb sy" ::: "memory");
+			return 0;
+		}
+	}
+	gicd_write32(0x180u + offset, mask); /* Roll back if the distributor never quiesces. */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
