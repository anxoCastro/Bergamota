+static void
+adsp_linux_asm_mode7_start(void)
+{
+	struct adsp_glink_survey_items items;
+	struct adsp_apr_channel_state state;
+	struct beryllium_adsp_glink_indices indices;
+	struct beryllium_adsp_audio_sequence sequence;
+	uint8_t packet[BERYLLIUM_ADSP_APR_MAX_DATA_BYTES] = { 0 };
+	uint16_t *pcm = NULL;
+	vm_size_t pcm_allocation_bytes = 0;
+	size_t packet_bytes = 0;
+	uint64_t iova = 0, dma_addr = 0;
+	uint32_t map_handle = 0;
+	uint16_t copp_id = 0;
+	bool route_installed = false;
+	bzero(&state, sizeof(state));
+	beryllium_adsp_audio_sequence_init(&sequence);
+	if (!sweet_board_beryllium() || !adsp_glink_survey_read_items(4, &items) ||
+	    !adsp_glink_start_items_valid(&items, true) ||
+	    !adsp_glink_survey_read_indices(items.descriptor.off, &indices) ||
+	    !beryllium_adsp_glink_indices_valid(&indices, items.tx_fifo.size, items.rx_fifo.size)) {
+		printf("SWEET ADSP AUDIO: mode 7 stopped: GLINK metadata/indices invalid\n");
+		return;
+	}
+	if (!adsp_audio_assert_tas_resets_low()) {
+		printf("SWEET ADSP AUDIO: mode 7 stopped before APR/SMMU setup; TAS reset GPIO verification failed\n");
+		return;
+	}
+	bzero(adsp_apr_rx_buffers, sizeof(adsp_apr_rx_buffers));
+	if (!adsp_apr_open_channel(&items, &state) ||
+	    !adsp_apr_advertise_local_intents(&items) ||
+	    !adsp_apr_wait_remote_intent(&items, &state)) {
+		printf("SWEET ADSP AUDIO: mode 7 stopped before Q6Core service query; TAS resets remain low\n");
+		return;
+	}
+	if (!adsp_apr_send_fwk_version(&items, &state) ||
+	    !adsp_apr_poll_response(&items, &state)) {
+		printf("SWEET ADSP AUDIO: mode 7 stopped without validated Q6Core service table; TAS resets remain low\n");
+		return;
+	}
+	if (!state.afe_api_v2 || !state.asm_adm_api_versions_valid) {
+		printf("SWEET ADSP AUDIO: mode 7 stopped; requires unique AFE API 2.0, ASM API 1.0, and ADM API 2.0\n");
+		return;
+	}
+	if (!adsp_audio_allocate_test_pcm(&pcm, &pcm_allocation_bytes)) {
+		return;
+	}
+	if (sweet_smmu_audio_map_buffer((uintptr_t)pcm,
+	    BERYLLIUM_ADSP_ASM_MAP_BYTES, &iova) != 0) {
+		printf("SWEET ADSP AUDIO: private SMMU map failed/uncertain; permanent PCM and any partial route retained until reboot\n");
+		return;
+	}
