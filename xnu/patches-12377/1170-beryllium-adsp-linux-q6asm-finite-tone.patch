+	    BERYLLIUM_ADSP_AUDIO_ADM_CLOSE, packet, packet_bytes,
+	    BERYLLIUM_ADSP_APR_ADM_SERVICE, BERYLLIUM_ADSP_ADM_DEVICE_CLOSE_V5,
+	    BERYLLIUM_ADSP_AUDIO_NO_PERIOD, "ADM COPP close") ||
+	    !beryllium_adsp_apr_encode_afe_device_command(packet, sizeof(packet),
+	    &packet_bytes, false) ||
+	    !adsp_apr_linux_audio_command(&items, &state, &sequence,
+	    BERYLLIUM_ADSP_AUDIO_AFE_STOP, packet, packet_bytes,
+	    BERYLLIUM_ADSP_APR_AFE_SERVICE, BERYLLIUM_ADSP_AFE_CMD_DEVICE_STOP,
+	    BERYLLIUM_ADSP_AUDIO_NO_PERIOD, "QUAT DEVICE_STOP")) {
+		goto retain;
+	}
+	if (!sequence.safe_to_restore ||
+	    sweet_smmu_audio_restore_mapping(SWEET_SMMU_AUDIO_ACK_RESTORE_REQUIRED) != 0 ||
+	    !beryllium_adsp_audio_sequence_restored(&sequence, true)) {
+		beryllium_adsp_audio_sequence_abort(&sequence);
+		goto retain;
+	}
+	printf("SWEET ADSP AUDIO: mode 7 complete; four matched WRITE_DONE events, SMMU state restored, TAS resets remain low\n");
+	return;
+retain:
+	if (route_installed) {
+		beryllium_adsp_audio_sequence_abort(&sequence);
+		printf("SWEET ADSP AUDIO: mode 7 failed/uncertain sequence.failed=%u; permanent PCM and private SMMU route retained until reboot\n",
+		    sequence.failed ? 1u : 0u);
+	} else {
+		printf("SWEET ADSP AUDIO: mode 7 stopped before a private SMMU route was installed\n");
+	}
+}
