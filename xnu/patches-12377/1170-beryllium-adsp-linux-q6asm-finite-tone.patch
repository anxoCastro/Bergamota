+static bool
+adsp_audio_allocate_test_pcm(uint16_t **pcm_out, vm_size_t *allocation_bytes)
+{
+	static const int16_t sine_quarter[24] = {
+		0, 67, 133, 196, 256, 312, 362, 406,
+		443, 473, 495, 508, 512, 508, 495, 473,
+		443, 406, 362, 312, 256, 196, 133, 67,
+	};
+	vm_offset_t pcm_va = 0;
+	vm_size_t bytes = round_page(BERYLLIUM_ADSP_ASM_MAP_BYTES);
+	if (pcm_out == NULL || allocation_bytes == NULL ||
+	    kmem_alloc_contig(kernel_map, &pcm_va, bytes, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET ADSP AUDIO: permanent PCM allocation failed\n");
+		return false;
+	}
+	uint16_t *pcm = (uint16_t *)pcm_va;
+	for (uint32_t frame = 0; frame < BERYLLIUM_ADSP_ASM_PCM_BYTES / 4u; frame++) {
+		uint32_t phase = frame % 48u;
+		int16_t sample = phase < 24u ? sine_quarter[phase] :
+		    (int16_t)-sine_quarter[phase - 24u];
+		pcm[frame * 2u] = (uint16_t)sample;
+		pcm[frame * 2u + 1u] = (uint16_t)sample;
+	}
+	ppnum_t first_page = pmap_find_phys(kernel_pmap, (addr64_t)pcm_va);
+	if (first_page == 0) {
+		printf("SWEET ADSP AUDIO: permanent PCM allocation has no physical page; retaining it until reboot\n");
+		return false;
+	}
+	sweet_dma_sync_va((const void *)pcm_va, bytes);
+	flush_dcache64((addr64_t)ptoa_64(first_page), bytes, TRUE);
+	*pcm_out = pcm;
+	*allocation_bytes = bytes;
+	printf("SWEET ADSP AUDIO: low-amplitude 1 kHz signed-16 stereo buffer initialized bytes=%u allocation=%#lx\n",
+	    BERYLLIUM_ADSP_ASM_PCM_BYTES, (unsigned long)bytes);
+	return true;
+}
+
+static bool
+adsp_apr_linux_audio_command(const struct adsp_glink_survey_items *items,
+	struct adsp_apr_channel_state *state,
+	struct beryllium_adsp_audio_sequence *sequence,
+	enum beryllium_adsp_audio_command sequence_command,
+	const uint8_t *packet, size_t packet_bytes, uint8_t service,
+	uint32_t request_opcode, unsigned period, const char *label)
+{
+	if (!beryllium_adsp_audio_sequence_begin(sequence, sequence_command, period)) {
+		printf("SWEET ADSP AUDIO: sequence refused command %s; no APR request sent\n",
+		    label);
+		return false;
+	}
+	if (!adsp_apr_send_linux_packet(items, state, packet, packet_bytes,
+	    service, request_opcode, label) || !adsp_apr_poll_response(items, state)) {
+		beryllium_adsp_audio_sequence_abort(sequence);
+		printf("SWEET ADSP AUDIO: %s response uncertain; stop and retain PCM/SMMU route until reboot\n",
+		    label);
+		return false;
+	}
+	bool accepted = state->response_status_valid && state->response_status == 0;
+	if (!beryllium_adsp_audio_sequence_complete(sequence, sequence_command,
+	    accepted)) {
+		printf("SWEET ADSP AUDIO: %s rejected/malformed status=%#x; stop and retain PCM/SMMU route until reboot\n",
+		    label, state->response_status_valid ? state->response_status : UINT32_MAX);
+		return false;
+	}
+	printf("SWEET ADSP AUDIO: %s acknowledged status=0\n", label);
+	return true;
+}
