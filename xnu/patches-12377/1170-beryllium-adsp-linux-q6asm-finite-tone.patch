diff --git a/bsd/dev/beryllium_adsp_audio_sequence.h b/bsd/dev/beryllium_adsp_audio_sequence.h
new file mode 100644
index 0000000..1d51a72
--- /dev/null
+++ b/bsd/dev/beryllium_adsp_audio_sequence.h
@@ -0,0 +1,176 @@
+#ifndef _BERYLLIUM_ADSP_AUDIO_SEQUENCE_H_
+#define _BERYLLIUM_ADSP_AUDIO_SEQUENCE_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "beryllium_adsp_apr_probe.h"
+
+#define BERYLLIUM_ADSP_AUDIO_NO_PERIOD (~0u)
+
+enum beryllium_adsp_audio_command {
+	BERYLLIUM_ADSP_AUDIO_ASM_MAP = 1,
+	BERYLLIUM_ADSP_AUDIO_ASM_OPEN,
+	BERYLLIUM_ADSP_AUDIO_ADM_OPEN,
+	BERYLLIUM_ADSP_AUDIO_ADM_MATRIX,
+	BERYLLIUM_ADSP_AUDIO_PCM_FORMAT,
+	BERYLLIUM_ADSP_AUDIO_AFE_CLOCK,
+	BERYLLIUM_ADSP_AUDIO_AFE_CONFIG,
+	BERYLLIUM_ADSP_AUDIO_AFE_START,
+	BERYLLIUM_ADSP_AUDIO_ASM_RUN,
+	BERYLLIUM_ADSP_AUDIO_ASM_WRITE,
+	BERYLLIUM_ADSP_AUDIO_ASM_CLOSE,
+	BERYLLIUM_ADSP_AUDIO_ASM_UNMAP,
+	BERYLLIUM_ADSP_AUDIO_ADM_CLOSE,
+	BERYLLIUM_ADSP_AUDIO_AFE_STOP,
+	BERYLLIUM_ADSP_AUDIO_RESTORE,
+};
+
+struct beryllium_adsp_audio_sequence {
+	enum beryllium_adsp_audio_command next_command;
+	enum beryllium_adsp_audio_command pending_command;
+	uint8_t writes_sent;
+	uint8_t writes_completed;
+	bool pending;
+	bool failed;
+	bool safe_to_restore;
+	bool complete;
+};
+
+static inline void
+beryllium_adsp_audio_sequence_init(struct beryllium_adsp_audio_sequence *sequence)
+{
+	if (sequence == NULL) {
+		return;
+	}
+	sequence->next_command = BERYLLIUM_ADSP_AUDIO_ASM_MAP;
+	sequence->pending_command = 0;
+	sequence->writes_sent = 0;
+	sequence->writes_completed = 0;
+	sequence->pending = false;
+	sequence->failed = false;
+	sequence->safe_to_restore = false;
+	sequence->complete = false;
+}
+
+static inline void
+beryllium_adsp_audio_sequence_abort(struct beryllium_adsp_audio_sequence *sequence)
+{
+	if (sequence != NULL) {
+		sequence->pending = false;
+		sequence->failed = true;
+		sequence->safe_to_restore = false;
+	}
+}
+
+static inline bool
+beryllium_adsp_audio_sequence_begin(struct beryllium_adsp_audio_sequence *sequence,
+	enum beryllium_adsp_audio_command command, unsigned period)
+{
+	if (sequence == NULL || sequence->failed || sequence->complete ||
+	    sequence->safe_to_restore || sequence->pending ||
+	    sequence->next_command != command) {
+		beryllium_adsp_audio_sequence_abort(sequence);
+		return false;
+	}
+	if (command == BERYLLIUM_ADSP_AUDIO_ASM_WRITE) {
+		if (period != sequence->writes_sent ||
+		    sequence->writes_sent >= BERYLLIUM_ADSP_ASM_PERIOD_COUNT ||
+		    sequence->writes_completed != sequence->writes_sent) {
+			beryllium_adsp_audio_sequence_abort(sequence);
+			return false;
+		}
+		sequence->writes_sent++;
+	} else if (period != BERYLLIUM_ADSP_AUDIO_NO_PERIOD) {
+		beryllium_adsp_audio_sequence_abort(sequence);
+		return false;
+	}
+	sequence->pending_command = command;
+	sequence->pending = true;
+	return true;
+}
+
+static inline bool
+beryllium_adsp_audio_sequence_complete(struct beryllium_adsp_audio_sequence *sequence,
+	enum beryllium_adsp_audio_command command, bool response_valid)
+{
+	if (sequence == NULL || sequence->failed || !sequence->pending ||
+	    sequence->pending_command != command) {
+		beryllium_adsp_audio_sequence_abort(sequence);
+		return false;
+	}
+	sequence->pending = false;
+	if (!response_valid) {
+		beryllium_adsp_audio_sequence_abort(sequence);
+		return false;
+	}
+	switch (command) {
+	case BERYLLIUM_ADSP_AUDIO_ASM_MAP:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_ASM_OPEN;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ASM_OPEN:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_ADM_OPEN;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ADM_OPEN:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_ADM_MATRIX;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ADM_MATRIX:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_PCM_FORMAT;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_PCM_FORMAT:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_AFE_CLOCK;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_AFE_CLOCK:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_AFE_CONFIG;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_AFE_CONFIG:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_AFE_START;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_AFE_START:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_ASM_RUN;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ASM_RUN:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_ASM_WRITE;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ASM_WRITE:
+		sequence->writes_completed++;
+		sequence->next_command = sequence->writes_completed <
+		    BERYLLIUM_ADSP_ASM_PERIOD_COUNT ? BERYLLIUM_ADSP_AUDIO_ASM_WRITE :
+		    BERYLLIUM_ADSP_AUDIO_ASM_CLOSE;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ASM_CLOSE:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_ASM_UNMAP;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ASM_UNMAP:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_ADM_CLOSE;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_ADM_CLOSE:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_AFE_STOP;
+		break;
+	case BERYLLIUM_ADSP_AUDIO_AFE_STOP:
+		sequence->next_command = BERYLLIUM_ADSP_AUDIO_RESTORE;
+		sequence->safe_to_restore = true;
+		break;
+	default:
+		beryllium_adsp_audio_sequence_abort(sequence);
+		return false;
+	}
+	return true;
+}
+
+static inline bool
+beryllium_adsp_audio_sequence_restored(struct beryllium_adsp_audio_sequence *sequence,
+	bool restored)
+{
+	if (sequence == NULL || sequence->failed || sequence->pending ||
+	    !sequence->safe_to_restore ||
+	    sequence->next_command != BERYLLIUM_ADSP_AUDIO_RESTORE || !restored) {
+		beryllium_adsp_audio_sequence_abort(sequence);
+		return false;
+	}
+	sequence->safe_to_restore = false;
+	sequence->complete = true;
+	return true;
+}
+
+#endif /* _BERYLLIUM_ADSP_AUDIO_SEQUENCE_H_ */
