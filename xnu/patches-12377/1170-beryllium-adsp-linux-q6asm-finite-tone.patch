+#define ADSP_TLMM_EAST_PA        0x03500000u /* TLMM 0x03400000 + EAST 0x100000 */
+#define ADSP_TLMM_SOUTH_PA       0x03d00000u /* TLMM 0x03400000 + SOUTH 0x900000 */
+#define ADSP_TLMM_GPIO_MAP_SIZE  0x00050000u
+#define ADSP_TLMM_GPIO_CFG(pin)  ((uint32_t)(pin) * 0x1000u)
+#define ADSP_TLMM_GPIO_IO(pin)   (ADSP_TLMM_GPIO_CFG(pin) + 4u)
+
+static uint32_t
+adsp_audio_gpio_read(vm_offset_t base, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+adsp_audio_gpio_write(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static bool
+adsp_audio_assert_tas_resets_low(void)
+{
+	vm_offset_t gpio12, gpio76;
+	uint32_t cfg12, cfg76, io12, io76;
+	if (!sweet_board_beryllium()) {
+		return false;
+	}
+	/* SDM845 pinctrl places reset GPIO 12 in SOUTH and GPIO 76 in EAST. */
+	gpio12 = ml_io_map(ADSP_TLMM_SOUTH_PA, ADSP_TLMM_GPIO_MAP_SIZE);
+	gpio76 = ml_io_map(ADSP_TLMM_EAST_PA, ADSP_TLMM_GPIO_MAP_SIZE);
+	if (gpio12 == 0 || gpio76 == 0) {
+		printf("SWEET ADSP AUDIO: TAS reset TLMM windows unavailable; refusing SMMU setup\n");
+		return false;
+	}
+	cfg12 = adsp_audio_gpio_read(gpio12, ADSP_TLMM_GPIO_CFG(12));
+	cfg76 = adsp_audio_gpio_read(gpio76, ADSP_TLMM_GPIO_CFG(76));
+	io12 = adsp_audio_gpio_read(gpio12, ADSP_TLMM_GPIO_IO(12));
+	io76 = adsp_audio_gpio_read(gpio76, ADSP_TLMM_GPIO_IO(76));
+	printf("SWEET ADSP AUDIO: TAS reset GPIO 12 SOUTH cfg=%#x io=%#x; GPIO 76 EAST cfg=%#x io=%#x\n",
+	    cfg12, io12, cfg76, io76);
+	/* Write both low output latches before enabling either pin as an output. */
+	adsp_audio_gpio_write(gpio12, ADSP_TLMM_GPIO_IO(12), io12 & ~2u);
+	adsp_audio_gpio_write(gpio76, ADSP_TLMM_GPIO_IO(76), io76 & ~2u);
+	cfg12 = (cfg12 & ~0x3ffu) | 0x200u; /* GPIO mux, no pull, 2 mA, output */
+	cfg76 = (cfg76 & ~0x3ffu) | 0x200u;
+	adsp_audio_gpio_write(gpio12, ADSP_TLMM_GPIO_CFG(12), cfg12);
+	adsp_audio_gpio_write(gpio76, ADSP_TLMM_GPIO_CFG(76), cfg76);
+	cfg12 = adsp_audio_gpio_read(gpio12, ADSP_TLMM_GPIO_CFG(12));
+	cfg76 = adsp_audio_gpio_read(gpio76, ADSP_TLMM_GPIO_CFG(76));
+	io12 = adsp_audio_gpio_read(gpio12, ADSP_TLMM_GPIO_IO(12));
+	io76 = adsp_audio_gpio_read(gpio76, ADSP_TLMM_GPIO_IO(76));
+	if ((cfg12 & 0x3ffu) != 0x200u || (cfg76 & 0x3ffu) != 0x200u ||
+	    (io12 & 3u) != 0 || (io76 & 3u) != 0) {
+		printf("SWEET ADSP AUDIO: TAS reset GPIO 12/76 output-low verification failed; GPIO 12 io=%#x cfg=%#x GPIO 76 io=%#x cfg=%#x\n",
+		    io12, cfg12, io76, cfg76);
+		return false;
+	}
+	printf("SWEET ADSP AUDIO: TAS reset GPIO 12 and GPIO 76 read input-low/output-low; held low\n");
+	return true;
+}
