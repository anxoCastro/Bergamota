+	    BERYLLIUM_ADSP_APR_ASM_SERVICE,
+	    BERYLLIUM_ADSP_ASM_SHARED_MEM_UNMAP_REGIONS,
+	    BERYLLIUM_ADSP_AUDIO_NO_PERIOD, "ASM shared-memory unmap") ||
