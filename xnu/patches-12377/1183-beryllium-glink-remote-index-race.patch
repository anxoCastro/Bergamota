+/* Only the AP-owned TX producer index must stay fixed while preparing a send.
+ * The DSP may consume TX data and advance tx_tail during this snapshot; the
+ * independent RX indices may also advance without affecting TX availability.
+ */
+static inline bool
+beryllium_adsp_glink_tx_head_stable(
+    const struct beryllium_adsp_glink_indices *first,
+    const struct beryllium_adsp_glink_indices *second)
+{
+	return first != NULL && second != NULL && first->tx_head == second->tx_head;
+}
