@@ -217,6 +217,24 @@ beryllium_adsp_apr_put32(uint8_t *p, uint32_t value)
 	p[3] = (uint8_t)(value >> 24);
 }
 
+static inline bool
+beryllium_adsp_apr_linux_transport_route(uint8_t *packet, size_t capacity,
+	size_t packet_bytes, uint8_t service)
+{
+	if (packet == NULL || packet_bytes < BERYLLIUM_ADSP_APR_HEADER_BYTES ||
+	    packet_bytes > capacity ||
+	    (service != BERYLLIUM_ADSP_APR_AFE_SERVICE &&
+	    service != BERYLLIUM_ADSP_APR_ASM_SERVICE &&
+	    service != BERYLLIUM_ADSP_APR_ADM_SERVICE)) {
+		return false;
+	}
+	packet[4] = service;
+	packet[5] = BERYLLIUM_ADSP_APR_DOMAIN_APPS;
+	packet[8] = service;
+	packet[9] = BERYLLIUM_ADSP_APR_DOMAIN_ADSP;
+	return true;
+}
