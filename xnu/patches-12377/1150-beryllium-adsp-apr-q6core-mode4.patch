diff --git a/bsd/dev/beryllium_adsp_apr_probe.h b/bsd/dev/beryllium_adsp_apr_probe.h
new file mode 100644
index 0000000..70324ad
--- /dev/null
+++ b/bsd/dev/beryllium_adsp_apr_probe.h
@@ -0,0 +1,283 @@
+#ifndef _BERYLLIUM_ADSP_APR_PROBE_H_
+#define _BERYLLIUM_ADSP_APR_PROBE_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define BERYLLIUM_ADSP_APR_DOMAIN_ADSP 4u
+#define BERYLLIUM_ADSP_APR_DOMAIN_APPS 5u
+#define BERYLLIUM_ADSP_APR_Q6CORE_SERVICE 3u
+#define BERYLLIUM_ADSP_APR_HEADER_BYTES 20u
+#define BERYLLIUM_ADSP_APR_SEQ_CMD_HDR_FIELD 0x0250u
+#define BERYLLIUM_ADSP_APR_RSP_HDR_FIELD 0x0150u
+#define BERYLLIUM_ADSP_APR_CMD_GET_FWK_VERSION 0x001292cu
+#define BERYLLIUM_ADSP_APR_RSP_GET_FWK_VERSION 0x001292du
+#define BERYLLIUM_ADSP_APR_BASIC_RSP_RESULT 0x000110e8u
+#define BERYLLIUM_ADSP_APR_CHANNEL_NAME "apr_audio_svc"
+#define BERYLLIUM_ADSP_APR_CHANNEL_NAME_BYTES 14u
+#define BERYLLIUM_ADSP_APR_INTENT_BYTES 512u
+#define BERYLLIUM_ADSP_APR_INTENT_COUNT 20u
+#define BERYLLIUM_ADSP_APR_MAX_REMOTE_INTENTS 64u
+#define BERYLLIUM_ADSP_APR_MAX_DATA_BYTES 512u
+
+#define BERYLLIUM_ADSP_GLINK_CMD_OPEN 2u
+#define BERYLLIUM_ADSP_GLINK_CMD_OPEN_ACK 4u
+#define BERYLLIUM_ADSP_GLINK_CMD_INTENT 5u
+#define BERYLLIUM_ADSP_GLINK_CMD_RX_DONE 6u
+#define BERYLLIUM_ADSP_GLINK_CMD_TX_DATA 9u
+
+enum beryllium_adsp_glink_frame_status {
+	BERYLLIUM_ADSP_GLINK_FRAME_MALFORMED = 0,
+	BERYLLIUM_ADSP_GLINK_FRAME_INCOMPLETE,
+	BERYLLIUM_ADSP_GLINK_FRAME_COMPLETE,
+};
+
+enum beryllium_adsp_apr_response_kind {
+	BERYLLIUM_ADSP_APR_RESPONSE_MALFORMED = 0,
+	BERYLLIUM_ADSP_APR_RESPONSE_FWK_VERSION,
+	BERYLLIUM_ADSP_APR_RESPONSE_BASIC_RESULT,
+};
+
+struct beryllium_adsp_glink_intent {
+	uint32_t id;
+	uint32_t size;
+};
+
+struct beryllium_adsp_apr_response {
+	uint32_t major;
+	uint32_t minor;
+	uint32_t branch;
+	uint32_t subbranch;
+	uint32_t service_count;
+	uint32_t status;
+};
+
+static inline uint16_t
+beryllium_adsp_apr_get16(const uint8_t *p)
+{
+	return (uint16_t)p[0] | ((uint16_t)p[1] << 8);
+}
+
+static inline uint32_t
+beryllium_adsp_apr_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline void
+beryllium_adsp_apr_put16(uint8_t *p, uint16_t value)
+{
+	p[0] = (uint8_t)value;
+	p[1] = (uint8_t)(value >> 8);
+}
+
+static inline void
+beryllium_adsp_apr_put32(uint8_t *p, uint32_t value)
+{
+	p[0] = (uint8_t)value;
+	p[1] = (uint8_t)(value >> 8);
+	p[2] = (uint8_t)(value >> 16);
+	p[3] = (uint8_t)(value >> 24);
+}
+
+static inline bool
+beryllium_adsp_apr_encode_get_fwk_version(uint8_t packet[BERYLLIUM_ADSP_APR_HEADER_BYTES])
+{
+	if (packet == NULL) {
+		return false;
+	}
+	for (size_t i = 0; i < BERYLLIUM_ADSP_APR_HEADER_BYTES; i++) {
+		packet[i] = 0;
+	}
+	beryllium_adsp_apr_put16(packet, BERYLLIUM_ADSP_APR_SEQ_CMD_HDR_FIELD);
+	beryllium_adsp_apr_put16(packet + 2, BERYLLIUM_ADSP_APR_HEADER_BYTES);
+	packet[4] = BERYLLIUM_ADSP_APR_Q6CORE_SERVICE;
+	packet[5] = BERYLLIUM_ADSP_APR_DOMAIN_APPS;
+	packet[8] = BERYLLIUM_ADSP_APR_Q6CORE_SERVICE;
+	packet[9] = BERYLLIUM_ADSP_APR_DOMAIN_ADSP;
+	beryllium_adsp_apr_put32(packet + 16, BERYLLIUM_ADSP_APR_CMD_GET_FWK_VERSION);
+	return true;
+}
+
+/* Compute the aligned GLINK frame length without reading past available bytes. */
+static inline enum beryllium_adsp_glink_frame_status
+beryllium_adsp_apr_glink_frame_bytes(const uint8_t *frame, size_t available,
+	size_t *frame_bytes)
+{
+	uint16_t command;
+	uint32_t param2, payload_bytes;
+	size_t raw_bytes, aligned_bytes;
+
+	if (frame == NULL || frame_bytes == NULL) {
+		return BERYLLIUM_ADSP_GLINK_FRAME_MALFORMED;
+	}
+	if (available < 8) {
+		return BERYLLIUM_ADSP_GLINK_FRAME_INCOMPLETE;
+	}
+	command = beryllium_adsp_apr_get16(frame);
+	param2 = beryllium_adsp_apr_get32(frame + 4);
+	switch (command) {
+	case BERYLLIUM_ADSP_GLINK_CMD_OPEN:
+		payload_bytes = param2 & 0xffffu;
+		if (payload_bytes == 0 || payload_bytes > 32) {
+			return BERYLLIUM_ADSP_GLINK_FRAME_MALFORMED;
+		}
+		raw_bytes = 8u + payload_bytes;
+		break;
+	case BERYLLIUM_ADSP_GLINK_CMD_OPEN_ACK:
+	case BERYLLIUM_ADSP_GLINK_CMD_RX_DONE:
+		raw_bytes = 8;
+		break;
+	case BERYLLIUM_ADSP_GLINK_CMD_INTENT:
+		if (param2 == 0 || param2 > BERYLLIUM_ADSP_APR_MAX_REMOTE_INTENTS) {
+			return BERYLLIUM_ADSP_GLINK_FRAME_MALFORMED;
+		}
+		raw_bytes = 8u + (size_t)param2 * 8u;
+		break;
+	case BERYLLIUM_ADSP_GLINK_CMD_TX_DATA:
+		if (available < 16) {
+			return BERYLLIUM_ADSP_GLINK_FRAME_INCOMPLETE;
+		}
+		payload_bytes = beryllium_adsp_apr_get32(frame + 8);
+		if (payload_bytes == 0 || payload_bytes > BERYLLIUM_ADSP_APR_MAX_DATA_BYTES ||
+		    beryllium_adsp_apr_get32(frame + 12) != 0) {
+			return BERYLLIUM_ADSP_GLINK_FRAME_MALFORMED;
+		}
+		raw_bytes = 16u + payload_bytes;
+		break;
+	default:
+		return BERYLLIUM_ADSP_GLINK_FRAME_MALFORMED;
+	}
+	aligned_bytes = (raw_bytes + 7u) & ~(size_t)7u;
+	if (available < aligned_bytes) {
+		return BERYLLIUM_ADSP_GLINK_FRAME_INCOMPLETE;
+	}
+	*frame_bytes = aligned_bytes;
+	return BERYLLIUM_ADSP_GLINK_FRAME_COMPLETE;
+}
+
+static inline bool
+beryllium_adsp_apr_open_name_valid(const uint8_t *frame, size_t frame_bytes,
+	uint16_t remote_channel_id)
+{
+	if (frame == NULL || remote_channel_id == 0 || frame_bytes != 24 ||
+	    beryllium_adsp_apr_get16(frame) != BERYLLIUM_ADSP_GLINK_CMD_OPEN ||
+	    beryllium_adsp_apr_get16(frame + 2) != remote_channel_id ||
+	    (beryllium_adsp_apr_get32(frame + 4) & 0xffffu) != BERYLLIUM_ADSP_APR_CHANNEL_NAME_BYTES) {
+		return false;
+	}
+	for (size_t i = 0; i < BERYLLIUM_ADSP_APR_CHANNEL_NAME_BYTES; i++) {
+		if (frame[8 + i] != (uint8_t)BERYLLIUM_ADSP_APR_CHANNEL_NAME[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static inline bool
+beryllium_adsp_apr_parse_remote_intents(const uint8_t *frame, size_t frame_bytes,
+	uint16_t remote_channel_id, struct beryllium_adsp_glink_intent *intents,
+	size_t intent_capacity, size_t *intent_count)
+{
+	uint32_t count;
+	if (frame == NULL || intents == NULL || intent_count == NULL ||
+	    frame_bytes < 16 || remote_channel_id == 0 ||
+	    beryllium_adsp_apr_get16(frame) != BERYLLIUM_ADSP_GLINK_CMD_INTENT ||
+	    beryllium_adsp_apr_get16(frame + 2) != remote_channel_id) {
+		return false;
+	}
+	count = beryllium_adsp_apr_get32(frame + 4);
+	if (count == 0 || count > BERYLLIUM_ADSP_APR_MAX_REMOTE_INTENTS ||
+	    count > intent_capacity || frame_bytes != 8u + (size_t)count * 8u) {
+		return false;
+	}
+	for (size_t i = 0; i < count; i++) {
+		uint32_t size = beryllium_adsp_apr_get32(frame + 8 + i * 8);
+		uint32_t id = beryllium_adsp_apr_get32(frame + 12 + i * 8);
+		if (size == 0 || size > 0x4000u || id == 0) {
+			return false;
+		}
+		for (size_t prior = 0; prior < i; prior++) {
+			if (intents[prior].id == id) {
+				return false;
+			}
+		}
+		intents[i].size = size;
+		intents[i].id = id;
+	}
+	*intent_count = count;
+	return true;
+}
+
+static inline bool
+beryllium_adsp_apr_tx_data_view(const uint8_t *frame, size_t frame_bytes,
+	uint16_t remote_channel_id, uint32_t local_intent_id,
+	const uint8_t **payload, size_t *payload_bytes)
+{
+	uint32_t length;
+	if (frame == NULL || payload == NULL || payload_bytes == NULL ||
+	    frame_bytes < 24 || remote_channel_id == 0 || local_intent_id == 0 ||
+	    beryllium_adsp_apr_get16(frame) != BERYLLIUM_ADSP_GLINK_CMD_TX_DATA ||
+	    beryllium_adsp_apr_get16(frame + 2) != remote_channel_id ||
+	    beryllium_adsp_apr_get32(frame + 12) != 0) {
+		return false;
+	}
+	length = beryllium_adsp_apr_get32(frame + 8);
+	if (length == 0 || length > BERYLLIUM_ADSP_APR_MAX_DATA_BYTES ||
+	    frame_bytes != ((16u + (size_t)length + 7u) & ~(size_t)7u) ||
+	    beryllium_adsp_apr_get32(frame + 4) != local_intent_id) {
+		return false;
+	}
+	*payload = frame + 16;
+	*payload_bytes = length;
+	return true;
+}
+
+static inline enum beryllium_adsp_apr_response_kind
+beryllium_adsp_apr_parse_response(const uint8_t *packet, size_t packet_bytes,
+	struct beryllium_adsp_apr_response *response)
+{
+	uint16_t packet_size;
+	uint32_t opcode;
+	if (packet == NULL || response == NULL || packet_bytes < BERYLLIUM_ADSP_APR_HEADER_BYTES) {
+		return BERYLLIUM_ADSP_APR_RESPONSE_MALFORMED;
+	}
+	packet_size = beryllium_adsp_apr_get16(packet + 2);
+	opcode = beryllium_adsp_apr_get32(packet + 16);
+	if (beryllium_adsp_apr_get16(packet) != BERYLLIUM_ADSP_APR_RSP_HDR_FIELD ||
+	    packet_size != packet_bytes || packet[4] != BERYLLIUM_ADSP_APR_Q6CORE_SERVICE ||
+	    packet[5] != BERYLLIUM_ADSP_APR_DOMAIN_ADSP ||
+	    beryllium_adsp_apr_get16(packet + 6) != 0 ||
+	    packet[8] != BERYLLIUM_ADSP_APR_Q6CORE_SERVICE ||
+	    packet[9] != BERYLLIUM_ADSP_APR_DOMAIN_APPS ||
+	    beryllium_adsp_apr_get16(packet + 10) != 0 ||
+	    beryllium_adsp_apr_get32(packet + 12) != 0) {
+		return BERYLLIUM_ADSP_APR_RESPONSE_MALFORMED;
+	}
+	if (opcode == BERYLLIUM_ADSP_APR_BASIC_RSP_RESULT) {
+		if (packet_bytes != BERYLLIUM_ADSP_APR_HEADER_BYTES + 8u ||
+		    beryllium_adsp_apr_get32(packet + 20) != BERYLLIUM_ADSP_APR_CMD_GET_FWK_VERSION) {
+			return BERYLLIUM_ADSP_APR_RESPONSE_MALFORMED;
+		}
+		response->status = beryllium_adsp_apr_get32(packet + 24);
+		return BERYLLIUM_ADSP_APR_RESPONSE_BASIC_RESULT;
+	}
+	if (opcode != BERYLLIUM_ADSP_APR_RSP_GET_FWK_VERSION || packet_bytes < 40 ||
+	    ((packet_bytes - 40u) % 12u) != 0) {
+		return BERYLLIUM_ADSP_APR_RESPONSE_MALFORMED;
+	}
+	response->major = beryllium_adsp_apr_get32(packet + 20);
+	response->minor = beryllium_adsp_apr_get32(packet + 24);
+	response->branch = beryllium_adsp_apr_get32(packet + 28);
+	response->subbranch = beryllium_adsp_apr_get32(packet + 32);
+	response->service_count = beryllium_adsp_apr_get32(packet + 36);
+	if (response->service_count > BERYLLIUM_ADSP_APR_MAX_DATA_BYTES / 12u ||
+	    packet_bytes != 40u + (size_t)response->service_count * 12u) {
+		return BERYLLIUM_ADSP_APR_RESPONSE_MALFORMED;
+	}
+	return BERYLLIUM_ADSP_APR_RESPONSE_FWK_VERSION;
+}
+
+#endif /* _BERYLLIUM_ADSP_APR_PROBE_H_ */
diff --git a/bsd/dev/beryllium_adsp_glink_start.h b/bsd/dev/beryllium_adsp_glink_start.h
index b519e8f..ff4dec1 100644
