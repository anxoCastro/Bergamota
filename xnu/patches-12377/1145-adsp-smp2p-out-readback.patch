+static void
+adsp_smp2p_out_snapshot(const char *stage)
+{
+	uint32_t data_off = 0, data_size = 0;
+	uint32_t magic, head1, pids, counts, flags;
+	uint16_t total, valid;
+	char name[17];
+	uint32_t value = 0;
+	bool found = false;
+
+	if (adsp_smem == NULL ||
+	    !adsp_smem_private_item(ADSP_LOCAL_PID, ADSP_REMOTE_PID,
+	    ADSP_SMP2P_OUT_ITEM, &data_off, &data_size)) {
+		printf("SWEET ADSP: outbound SMP2P readback (%s): item %u unavailable\n",
+		    stage, ADSP_SMP2P_OUT_ITEM);
+		return;
+	}
+	if (data_size < ADSP_SMP2P_HEADER_BYTES) {
+		printf("SWEET ADSP: outbound SMP2P readback (%s): item %u too small (%u bytes)\n",
+		    stage, ADSP_SMP2P_OUT_ITEM, data_size);
+		return;
+	}
+	__asm__ volatile ("dmb sy" ::: "memory");
+	magic = adsp_smem_rd32(data_off);
+	head1 = adsp_smem_rd32(data_off + 4);
+	pids = adsp_smem_rd32(data_off + 8);
+	counts = adsp_smem_rd32(data_off + 12);
+	flags = adsp_smem_rd32(data_off + 16);
+	total = (uint16_t)counts;
+	valid = (uint16_t)(counts >> 16);
+	if (magic != ADSP_SMP2P_MAGIC || (uint8_t)head1 == 0 || (uint8_t)head1 > 2 ||
+	    (uint16_t)pids != ADSP_LOCAL_PID || (uint16_t)(pids >> 16) != ADSP_REMOTE_PID ||
+	    total == 0 || total > ADSP_SMP2P_MAX_ENTRY || valid > total ||
+	    data_size < ADSP_SMP2P_HEADER_BYTES + (uint32_t)valid * ADSP_SMP2P_ENTRY_BYTES) {
+		printf("SWEET ADSP: outbound SMP2P readback (%s): invalid header magic=%#x version=%u pid=%u->%u entries=%u/%u flags=%#x\n",
+		    stage, magic, (unsigned)(uint8_t)head1, (unsigned)(uint16_t)pids,
+		    (unsigned)(uint16_t)(pids >> 16), (unsigned)valid, (unsigned)total, flags);
+		return;
+	}
+	for (uint16_t i = 0; i < valid; i++) {
+		uint32_t ent = data_off + ADSP_SMP2P_HEADER_BYTES +
+		    (uint32_t)i * ADSP_SMP2P_ENTRY_BYTES;
+		for (unsigned c = 0; c < 16; c++) {
+			uint8_t ch = adsp_smem[ent + c];
+			name[c] = ch == 0 ? '\0' : ((ch >= 0x20 && ch <= 0x7e) ? (char)ch : '?');
+		}
+		name[16] = '\0';
+		if (strcmp(name, "master-kernel") == 0) {
+			value = adsp_smem_rd32(ent + 16);
+			found = true;
+			break;
+		}
+	}
+	printf("SWEET ADSP: outbound SMP2P readback (%s): item %u version %u pid %u->%u entries %u/%u flags %#x master-kernel=%s value=%#x\n",
+	    stage, ADSP_SMP2P_OUT_ITEM, (unsigned)(uint8_t)head1,
+	    (unsigned)(uint16_t)pids, (unsigned)(uint16_t)(pids >> 16),
+	    (unsigned)valid, (unsigned)total, flags, found ? "present" : "missing", value);
+}
