+static int
+adsp_tas_sequence_set_reset(void *context, bool release)
+{
+	struct adsp_tas_hardware *hw = context;
+	if (hw == NULL || !adsp_tas_reset(hw->gpiosouth, hw->gpioeast, release))
+		return -1;
+	if (release)
+		delay(10000);
+	return 0;
+}
+
+static int
+adsp_tas_sequence_prepare_bus(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	if (hw == NULL || hw->gpioeast == 0)
+		return -1;
+	hw->sda_cfg = adsp_audio_gpio_read(hw->gpioeast,
+	    ADSP_TLMM_GPIO_CFG(ADSP_TAS_SDA_GPIO));
+	hw->sda_io = adsp_audio_gpio_read(hw->gpioeast,
+	    ADSP_TLMM_GPIO_IO(ADSP_TAS_SDA_GPIO));
+	hw->scl_cfg = adsp_audio_gpio_read(hw->gpioeast,
+	    ADSP_TLMM_GPIO_CFG(ADSP_TAS_SCL_GPIO));
+	hw->scl_io = adsp_audio_gpio_read(hw->gpioeast,
+	    ADSP_TLMM_GPIO_IO(ADSP_TAS_SCL_GPIO));
+	hw->pins_saved = true;
+	/* GPIO mode, 2 mA, no internal pulls; bit-bang code releases both lines. */
+	adsp_audio_gpio_write(hw->gpioeast, ADSP_TLMM_GPIO_CFG(ADSP_TAS_SDA_GPIO),
+	    (hw->sda_cfg & ~0x3ffu) | (2u << 6));
+	adsp_audio_gpio_write(hw->gpioeast, ADSP_TLMM_GPIO_CFG(ADSP_TAS_SCL_GPIO),
+	    (hw->scl_cfg & ~0x3ffu) | (2u << 6));
+	if (!adsp_tas_i2c_read_sda(&hw->bus) || !adsp_tas_i2c_read_scl(&hw->bus)) {
+		printf("SWEET TAS: SE5 SDA/SCL not both pulled high; resets stay low\n");
+		return -1;
+	}
+	return 0;
+}
+
+static int
+adsp_tas_sequence_identify(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	uint8_t left = 0, right = 0;
+	int left_result, right_result;
+	left_result = beryllium_tas_i2c_read_reg(&adsp_tas_i2c_ops, &hw->bus,
+	    ADSP_TAS2559_ADDR, ADSP_TAS2559_PGID_REG, &left);
+	right_result = left_result == BERYLLIUM_TAS_I2C_OK ?
+	    beryllium_tas_i2c_read_reg(&adsp_tas_i2c_ops, &hw->bus,
+	    ADSP_TAS2560_ADDR, ADSP_TAS2560_ID_REG, &right) :
+	    BERYLLIUM_TAS_I2C_INVALID;
+	printf("SWEET TAS: identity ACKs TAS2559=%d value=%#02x TAS2560=%d value=%#02x (values recorded, no fixed silicon allowlist)\n",
+	    left_result, left, right_result, right);
+	return left_result == BERYLLIUM_TAS_I2C_OK &&
+	    right_result == BERYLLIUM_TAS_I2C_OK ? 0 : -1;
+}
+
+static int
+adsp_tas_reg_write(struct adsp_tas_hardware *hw, unsigned device,
+	uint8_t book, uint8_t page, uint8_t reg, uint8_t value)
+{
+	return beryllium_tas_write_register(&hw->writer, device, book, page,
+	    reg, value);
+}
+
+static int
+adsp_tas_update_bits(struct adsp_tas_hardware *hw, unsigned device,
+	uint8_t book, uint8_t page, uint8_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t old_value;
+	int result = beryllium_tas_read_register(&hw->writer, device, book, page,
+	    reg, &old_value);
+	if (result != 0)
+		return result;
+	return adsp_tas_reg_write(hw, device, book, page, reg,
+	    (uint8_t)((old_value & ~mask) | (value & mask)));
+}
+
+static int
+adsp_tas_sequence_software_reset_defaults(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	int result;
+	result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 1, 1);
+	if (result == 0)
+		result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 1, 1);
+	if (result != 0)
+		return result;
+	delay(1000);
+	/* Sphinx tas2559_load_default() and Beryllium load_platdata() values. */
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 21, 0x05)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 45, 0x21)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 46, 0x21)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 80, 0x21)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 37, 0x5a)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 44, 0x00)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 33, 0x00)) != 0 ||
+	    (result = adsp_tas_update_bits(hw, BERYLLIUM_TAS_DEVA, 0, 1, 1, 0x01, 0x01)) != 0 ||
+	    (result = adsp_tas_update_bits(hw, BERYLLIUM_TAS_DEVB, 0, 0, 24, 0x02, 0x02)) != 0 ||
+	    (result = adsp_tas_update_bits(hw, BERYLLIUM_TAS_DEVA, 0, 1, 80, 0x30, 0x30)) != 0)
+		return result;
+	printf("SWEET TAS: Linux software reset/defaults applied; forced VBoost is disabled\n");
+	return 0;
+}
+
+static int
+adsp_tas_sequence_load_block(void *context,
+	const struct beryllium_tas_block *block, bool ycrc_enabled)
+{
+	struct adsp_tas_hardware *hw = context;
+	return beryllium_tas_load_block(&hw->writer, block, ycrc_enabled);
+}
+
+static int
+adsp_tas_sequence_startup(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	int result;
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 1, 61, 0x01)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 1, 62, 0x01)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 5, 0xa0)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 5, 0xa3)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 4, 0xf8)) != 0)
+		return result;
+	delay(2000);
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 2, 0x02)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 7, 0x41)) != 0)
+		return result;
+	delay(2000);
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 44, 0x2b)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 33, 0x0b)) != 0)
+		return result;
+	return 0;
+}
+
+static int
+adsp_tas_sequence_unmute(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	int result;
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 7, 0x00)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 7, 0x40)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 100, 0, 7, 0x00)) != 0)
+		return result;
+	return 0;
+}
+
+static int
+adsp_tas_sequence_mute(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	int result;
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 100, 0, 7, 0x01)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 7, 0x41)) != 0)
+		return result;
+	delay(10000);
+	return adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 7, 0x03);
+}
+
+static int
+adsp_tas_sequence_shutdown(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	int result;
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 44, 0x00)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 33, 0x00)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 100, 0, 7, 0x01)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 7, 0x41)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 7, 0x01)) != 0)
+		return result;
+	delay(10000);
+	delay(20000);
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 4, 0x60)) != 0)
+		return result;
+	delay(2000);
+	if ((result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 7, 0x03)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 5, 0x00)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 0, 4, 0x00)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVB, 0, 0, 2, 0x01)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 1, 61, 0x00)) != 0 ||
+	    (result = adsp_tas_reg_write(hw, BERYLLIUM_TAS_DEVA, 0, 1, 62, 0x00)) != 0)
+		return result;
+	return 0;
+}
+
+static int
+adsp_tas_sequence_restore_bus(void *context)
+{
+	struct adsp_tas_hardware *hw = context;
+	if (!hw->pins_saved)
+		return 0;
+	adsp_audio_gpio_write(hw->gpioeast, ADSP_TLMM_GPIO_IO(ADSP_TAS_SDA_GPIO),
+	    hw->sda_io);
+	adsp_audio_gpio_write(hw->gpioeast, ADSP_TLMM_GPIO_IO(ADSP_TAS_SCL_GPIO),
+	    hw->scl_io);
+	adsp_audio_gpio_write(hw->gpioeast, ADSP_TLMM_GPIO_CFG(ADSP_TAS_SDA_GPIO),
+	    hw->sda_cfg);
+	adsp_audio_gpio_write(hw->gpioeast, ADSP_TLMM_GPIO_CFG(ADSP_TAS_SCL_GPIO),
+	    hw->scl_cfg);
+	if (adsp_audio_gpio_read(hw->gpioeast, ADSP_TLMM_GPIO_CFG(ADSP_TAS_SDA_GPIO)) !=
+	    hw->sda_cfg || adsp_audio_gpio_read(hw->gpioeast,
+	    ADSP_TLMM_GPIO_IO(ADSP_TAS_SDA_GPIO)) != hw->sda_io ||
+	    adsp_audio_gpio_read(hw->gpioeast, ADSP_TLMM_GPIO_CFG(ADSP_TAS_SCL_GPIO)) !=
+	    hw->scl_cfg || adsp_audio_gpio_read(hw->gpioeast,
+	    ADSP_TLMM_GPIO_IO(ADSP_TAS_SCL_GPIO)) != hw->scl_io)
+		return -1;
+	hw->pins_saved = false;
+	return 0;
+}
