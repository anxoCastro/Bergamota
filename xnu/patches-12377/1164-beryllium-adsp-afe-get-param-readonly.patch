+	beryllium_adsp_apr_put32(packet + 44,
+	    BERYLLIUM_ADSP_AFE_MODULE_AUDIO_DEV_INTERFACE);
+	beryllium_adsp_apr_put32(packet + 48, BERYLLIUM_ADSP_AFE_PARAM_I2S_CONFIG);
+	beryllium_adsp_apr_put16(packet + 52, BERYLLIUM_ADSP_AFE_I2S_CONFIG_BYTES);
+	*packet_bytes = BERYLLIUM_ADSP_AFE_GET_PARAM_BYTES;
+	return true;
