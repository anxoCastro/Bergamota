+static bool
+adsp_apr_send_afe_i2s_get_param(const struct adsp_glink_survey_items *items,
+	struct adsp_apr_channel_state *state)
+{
+	uint8_t apr_packet[BERYLLIUM_ADSP_AFE_GET_PARAM_BYTES] = { 0 };
+	uint8_t frame[16 + BERYLLIUM_ADSP_AFE_GET_PARAM_BYTES] = { 0 };
+	const struct beryllium_adsp_glink_intent *selected = NULL;
+	size_t packet_bytes = 0;
+	if (items == NULL || state == NULL || !state->request_intent_reusable) {
+		printf("SWEET ADSP: AFE GET_PARAM skipped; previous remote intent is not reusable\n");
+		return false;
+	}
+	for (size_t i = 0; i < state->remote_intent_count; i++) {
+		const struct beryllium_adsp_glink_intent *candidate =
+		    &state->remote_intents[i];
+		if (candidate->id != state->request_intent_id ||
+		    candidate->size < BERYLLIUM_ADSP_AFE_GET_PARAM_BYTES) {
+			continue;
+		}
+		selected = candidate;
+		break;
+	}
+	if (selected == NULL || !beryllium_adsp_apr_encode_afe_get_i2s_config(
+	    apr_packet, sizeof(apr_packet), &packet_bytes) ||
+	    packet_bytes != sizeof(apr_packet)) {
+		printf("SWEET ADSP: AFE GET_PARAM stopped; no reusable remote intent fits the bounded request\n");
+		return false;
+	}
+	state->request_intent_id = selected->id;
+	state->request_opcode = BERYLLIUM_ADSP_AFE_CMD_GET_PARAM_V2;
+	state->request_intent_reusable = false;
+	beryllium_adsp_apr_put16(frame, BERYLLIUM_ADSP_GLINK_CMD_TX_DATA);
+	beryllium_adsp_apr_put16(frame + 2, ADSP_APR_LOCAL_CHANNEL);
+	beryllium_adsp_apr_put32(frame + 4, selected->id);
+	beryllium_adsp_apr_put32(frame + 8, packet_bytes);
+	beryllium_adsp_apr_put32(frame + 12, 0);
+	for (size_t i = 0; i < packet_bytes; i++) {
+		frame[16 + i] = apr_packet[i];
+	}
+	if (!adsp_glink_send_frame(items, frame, sizeof(frame))) {
+		printf("SWEET ADSP: AFE GET_PARAM GLINK TX failed\n");
+		return false;
+	}
+	printf("SWEET ADSP: sent one read-only AFE GET_PARAM_V2 service=%u port=%#x module=%#x param=%#x intent=%u\n",
+	    BERYLLIUM_ADSP_APR_AFE_SERVICE,
+	    BERYLLIUM_ADSP_AFE_PORT_QUAT_MI2S_RX,
+	    BERYLLIUM_ADSP_AFE_MODULE_AUDIO_DEV_INTERFACE,
+	    BERYLLIUM_ADSP_AFE_PARAM_I2S_CONFIG, selected->id);
+	return true;
+}
