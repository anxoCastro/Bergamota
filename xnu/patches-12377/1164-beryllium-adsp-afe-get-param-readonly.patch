+static inline bool
+beryllium_adsp_apr_encode_afe_get_i2s_config(uint8_t *packet,
+	size_t packet_capacity, size_t *packet_bytes)
+{
+	if (packet == NULL || packet_bytes == NULL ||
+	    packet_capacity < BERYLLIUM_ADSP_AFE_GET_PARAM_BYTES) {
+		return false;
+	}
+	for (size_t i = 0; i < BERYLLIUM_ADSP_AFE_GET_PARAM_BYTES; i++) {
+		packet[i] = 0;
+	}
+	beryllium_adsp_apr_put16(packet, BERYLLIUM_ADSP_APR_SEQ_CMD_HDR_FIELD);
+	beryllium_adsp_apr_put16(packet + 2, BERYLLIUM_ADSP_AFE_GET_PARAM_BYTES);
+	packet[4] = BERYLLIUM_ADSP_APR_AFE_SERVICE;
+	packet[5] = BERYLLIUM_ADSP_APR_DOMAIN_APPS;
+	packet[8] = BERYLLIUM_ADSP_APR_AFE_SERVICE;
+	packet[9] = BERYLLIUM_ADSP_APR_DOMAIN_ADSP;
