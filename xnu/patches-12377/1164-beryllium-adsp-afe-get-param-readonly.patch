+static inline bool
+beryllium_adsp_apr_afe_api_v2_available(
+	const struct beryllium_adsp_apr_response *response)
+{
+	uint32_t matches = 0;
+	bool supported = false;
+	if (response == NULL || response->service_count >
+	    BERYLLIUM_ADSP_APR_MAX_DATA_BYTES / 12u) {
+		return false;
+	}
+	for (uint32_t i = 0; i < response->service_count; i++) {
+		if (response->services[i].service_id != BERYLLIUM_ADSP_APR_AFE_SERVICE) {
+			continue;
+		}
+		matches++;
+		supported = response->services[i].api_version == 2u &&
+		    response->services[i].api_branch_version == 0u;
+	}
+	return matches == 1u && supported;
+}
