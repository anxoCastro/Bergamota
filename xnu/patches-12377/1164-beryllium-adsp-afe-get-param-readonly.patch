+	    packet_bytes > BERYLLIUM_ADSP_APR_MAX_DATA_BYTES) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_MALFORMED;
+	}
+	header_field = beryllium_adsp_apr_get16(packet);
+	header_version = (uint8_t)(header_field & 0x000fu);
+	header_words = (uint8_t)((header_field & 0x00f0u) >> 4);
+	message_type = (uint8_t)((header_field & 0x0300u) >> 8);
+	header_bytes = (size_t)header_words * 4u;
+	if (header_version > 1u || message_type != 1u ||
+	    (header_field & 0xfc00u) != 0 ||
+	    header_bytes < BERYLLIUM_ADSP_APR_HEADER_BYTES ||
+	    header_bytes > packet_bytes) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_MALFORMED;
+	}
+	packet_size = beryllium_adsp_apr_get16(packet + 2);
+	opcode = beryllium_adsp_apr_get32(packet + 16);
+	if (packet_size != packet_bytes ||
+	    packet[4] != BERYLLIUM_ADSP_APR_AFE_SERVICE ||
+	    packet[5] != BERYLLIUM_ADSP_APR_DOMAIN_ADSP ||
+	    beryllium_adsp_apr_get16(packet + 6) != 0 ||
+	    packet[8] != BERYLLIUM_ADSP_APR_AFE_SERVICE ||
+	    packet[9] != BERYLLIUM_ADSP_APR_DOMAIN_APPS ||
+	    beryllium_adsp_apr_get16(packet + 10) != 0 ||
+	    beryllium_adsp_apr_get32(packet + 12) !=
+	    BERYLLIUM_ADSP_AFE_QUAT_MI2S_TOKEN) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_MALFORMED;
+	}
+	body = packet + header_bytes;
+	body_bytes = packet_bytes - header_bytes;
+	if (opcode == BERYLLIUM_ADSP_APR_BASIC_RSP_RESULT) {
+		if (body_bytes != 8u ||
+		    beryllium_adsp_apr_get32(body) !=
+		    BERYLLIUM_ADSP_AFE_CMD_GET_PARAM_V2) {
+			return BERYLLIUM_ADSP_AFE_RESPONSE_MALFORMED;
+		}
+		response->status = beryllium_adsp_apr_get32(body + 4);
+		return BERYLLIUM_ADSP_AFE_RESPONSE_BASIC_RESULT;
+	}
+	if (opcode != BERYLLIUM_ADSP_AFE_RSP_GET_PARAM_V2 || body_bytes < 4u) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_MALFORMED;
+	}
+	response->status = beryllium_adsp_apr_get32(body);
+	if (response->status != 0 && body_bytes == 4u) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_STATUS;
+	}
+	if (body_bytes != 4u + BERYLLIUM_ADSP_AFE_PARAM_HEADER_BYTES +
+	    BERYLLIUM_ADSP_AFE_I2S_CONFIG_BYTES ||
+	    beryllium_adsp_apr_get32(body + 4) !=
+	    BERYLLIUM_ADSP_AFE_MODULE_AUDIO_DEV_INTERFACE ||
+	    beryllium_adsp_apr_get32(body + 8) !=
+	    BERYLLIUM_ADSP_AFE_PARAM_I2S_CONFIG ||
+	    beryllium_adsp_apr_get16(body + 12) !=
+	    BERYLLIUM_ADSP_AFE_I2S_CONFIG_BYTES ||
+	    beryllium_adsp_apr_get16(body + 14) != 0) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_MALFORMED;
+	}
+	if (response->status != 0) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_STATUS;
+	}
+	const uint8_t *config = body + 16;
+	response->i2s.minor_version = beryllium_adsp_apr_get32(config);
+	response->i2s.bit_width = beryllium_adsp_apr_get16(config + 4);
+	response->i2s.channel_mode = beryllium_adsp_apr_get16(config + 6);
+	response->i2s.mono_stereo = beryllium_adsp_apr_get16(config + 8);
+	response->i2s.ws_source = beryllium_adsp_apr_get16(config + 10);
+	response->i2s.sample_rate = beryllium_adsp_apr_get32(config + 12);
+	response->i2s.data_format = beryllium_adsp_apr_get16(config + 16);
+	if (beryllium_adsp_apr_get16(config + 18) != 0) {
+		return BERYLLIUM_ADSP_AFE_RESPONSE_MALFORMED;
+	}
+	return BERYLLIUM_ADSP_AFE_RESPONSE_GET_PARAM;
+}
+
 #endif /* _BERYLLIUM_ADSP_APR_PROBE_H_ */
