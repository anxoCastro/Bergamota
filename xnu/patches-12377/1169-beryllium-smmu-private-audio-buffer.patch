diff --git a/bsd/dev/sweet_smmu.c b/bsd/dev/sweet_smmu.c
index d7dc290..3aa5b8b 100644
--- a/bsd/dev/sweet_smmu.c
+++ b/bsd/dev/sweet_smmu.c
@@ -33,6 +33,7 @@
 #include <vm/vm_kern.h>
 #include <vm/vm_kern_xnu.h>
 #include "sweet_board.h"
+#include "sweet_smmu_audio_private.h"
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
@@ -42,12 +43,14 @@ int sweet_smmu_probe_sid(unsigned sid, unsigned level);
 #define SMMU_PA         0x15000000u     /* apps_smmu */
 #define SMMU_SIZE       0x100000u
 #define L1_SIZE         0x1000u         /* one 512-entry level-1 table */
+#define AUDIO_PT_BYTES  (3u * SWEET_SMMU_AUDIO_PAGE_BYTES)
 
 static vm_offset_t smmu_base;
 static int smmu_cb = -1;                /* shared translating context bank */
 static unsigned smmu_nsmr;
 static int smmu_next_smr;               /* first free SMR to try next */
 static volatile uint32_t smmu_lock;
+static struct sweet_smmu_audio_mapping smmu_audio_mapping;
 
 static uint32_t
 smmu_rd(uint32_t off)
@@ -311,4 +314,176 @@ out:
 	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
 	return result;
 }
+
+static uint32_t
+smmu_audio_read32(void *context, uint32_t offset)
+{
+	(void)context;
+	return smmu_rd(offset);
+}
+
+static void
+smmu_audio_write32(void *context, uint32_t offset, uint32_t value)
+{
+	(void)context;
+	smmu_wr(offset, value);
+}
+
+static void
+smmu_audio_write64(void *context, uint32_t offset, uint64_t value)
+{
+	(void)context;
+	smmu_wr64(offset, value);
+}
+
+int
+sweet_smmu_audio_map_buffer(uintptr_t buffer_va, size_t bytes, uint64_t *iova)
+{
+	vm_offset_t tables_va = 0;
+	vm_size_t tables_size;
+	ppnum_t buffer_pn, tables_pn;
+	uint64_t buffer_pa, tables_pa;
+	int error = EINVAL;
+	struct sweet_smmu_audio_mapping mapping = { 0 };
+	struct sweet_smmu_audio_io io = {
+		.context = NULL,
+		.read32 = smmu_audio_read32,
+		.write32 = smmu_audio_write32,
+		.write64 = smmu_audio_write64,
+	};
+
+	if (iova == NULL || buffer_va == 0 || bytes != SWEET_SMMU_AUDIO_MAP_BYTES ||
+	    (buffer_va & PAGE_MASK) != 0) {
+		return EINVAL;
+	}
+	vm_size_t buffer_alloc_size = round_page((vm_size_t)bytes);
+	if (buffer_va > UINTPTR_MAX - buffer_alloc_size) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (smmu_audio_mapping.prepared || smmu_audio_mapping.installed ||
+	    smmu_audio_mapping.uncertain) {
+		__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+		return EBUSY;
+	}
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+
+	buffer_pn = pmap_find_phys(kernel_pmap, (addr64_t)buffer_va);
+	if (buffer_pn == 0) {
+		return EFAULT;
+	}
+	for (vm_size_t offset = PAGE_SIZE; offset < buffer_alloc_size; offset += PAGE_SIZE) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(buffer_va + offset)) !=
+		    buffer_pn + (offset / PAGE_SIZE)) {
+			printf("SWEET SMMU AUDIO: PCM allocation is not physically contiguous\n");
+			return EINVAL;
+		}
+	}
+	buffer_pa = ptoa_64(buffer_pn);
+	if (buffer_pa >= SWEET_SMMU_AUDIO_PA_LIMIT ||
+	    bytes > SWEET_SMMU_AUDIO_PA_LIMIT - buffer_pa) {
+		return EINVAL;
+	}
+
+	/* XNU may use 16 KiB pages; each 4 KiB SMMU table still gets its own slot. */
+	tables_size = round_page(AUDIO_PT_BYTES);
+	if (kmem_alloc_contig(kernel_map, &tables_va, tables_size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET SMMU AUDIO: permanent page-table allocation failed\n");
+		return ENOMEM;
+	}
+	tables_pn = pmap_find_phys(kernel_pmap, (addr64_t)tables_va);
+	if (tables_pn == 0) {
+		return EFAULT;
+	}
+	for (vm_size_t offset = PAGE_SIZE; offset < tables_size; offset += PAGE_SIZE) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(tables_va + offset)) !=
+		    tables_pn + (offset / PAGE_SIZE)) {
+			printf("SWEET SMMU AUDIO: page-table allocation is not contiguous\n");
+			return EINVAL;
+		}
+	}
+	tables_pa = ptoa_64(tables_pn);
+	if (tables_pa >= SWEET_SMMU_AUDIO_PA_LIMIT ||
+	    tables_pa + AUDIO_PT_BYTES > SWEET_SMMU_AUDIO_PA_LIMIT) {
+		return EINVAL;
+	}
+	uint64_t *l1 = (uint64_t *)tables_va;
+	uint64_t *l2 = (uint64_t *)(tables_va + SWEET_SMMU_AUDIO_PAGE_BYTES);
+	uint64_t *l3 = (uint64_t *)(tables_va + 2 * SWEET_SMMU_AUDIO_PAGE_BYTES);
+	uint64_t l1_pa = tables_pa;
+	uint64_t l2_pa = tables_pa + SWEET_SMMU_AUDIO_PAGE_BYTES;
+	uint64_t l3_pa = tables_pa + 2 * SWEET_SMMU_AUDIO_PAGE_BYTES;
+	error = sweet_smmu_audio_build_tables(l1, l1_pa, l2, l2_pa, l3, l3_pa,
+	    SWEET_SMMU_AUDIO_IOVA, buffer_pa, bytes);
+	if (error != SWEET_SMMU_AUDIO_OK) {
+		return EINVAL;
+	}
+	sweet_dma_sync_va((const void *)tables_va, tables_size);
+	flush_dcache64((addr64_t)tables_pa, tables_size, TRUE);
+
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (smmu_audio_mapping.prepared || smmu_audio_mapping.installed ||
+	    smmu_audio_mapping.uncertain) {
+		error = EBUSY;
+		goto audio_out;
+	}
+	if (smmu_base == 0) {
+		smmu_base = ml_io_map(SMMU_PA, SMMU_SIZE);
+	}
+	if (smmu_base == 0) {
+		error = ENXIO;
+		goto audio_out;
+	}
+	error = sweet_smmu_audio_prepare(&io, SWEET_SMMU_AUDIO_SID, &mapping);
+	if (error != SWEET_SMMU_AUDIO_OK) {
+		printf("SWEET SMMU AUDIO: no private route for SID 0x%x (state %d)\n",
+		    SWEET_SMMU_AUDIO_SID, error);
+		goto audio_out;
+	}
+	error = sweet_smmu_audio_install(&io, SWEET_SMMU_AUDIO_SID, &mapping, l1_pa);
+	if (mapping.uncertain || mapping.installed) {
+		smmu_audio_mapping = mapping;
+	}
+	if (error == SWEET_SMMU_AUDIO_OK) {
+		*iova = SWEET_SMMU_AUDIO_IOVA;
+		printf("SWEET SMMU AUDIO: SID 0x%x -> SMR %u / private CB %u, IOVA %#llx PA %#llx size %#zx\n",
+		    SWEET_SMMU_AUDIO_SID, mapping.smr_index, mapping.cb_index,
+		    (unsigned long long)SWEET_SMMU_AUDIO_IOVA,
+		    (unsigned long long)buffer_pa, bytes);
+	}
+audio_out:
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+	return error == SWEET_SMMU_AUDIO_OK ? 0 : error;
+}
+
+int
+sweet_smmu_audio_restore_mapping(unsigned ack_mask)
+{
+	struct sweet_smmu_audio_io io = {
+		.context = NULL,
+		.read32 = smmu_audio_read32,
+		.write32 = smmu_audio_write32,
+		.write64 = smmu_audio_write64,
+	};
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = sweet_smmu_audio_restore(&io, &smmu_audio_mapping, ack_mask);
+	if (error == SWEET_SMMU_AUDIO_OK) {
+		printf("SWEET SMMU AUDIO: restored SID 0x%x SMR %u and private CB %u; permanent pages retained until reboot\n",
+		    SWEET_SMMU_AUDIO_SID, smmu_audio_mapping.smr_index,
+		    smmu_audio_mapping.cb_index);
+	} else {
+		printf("SWEET SMMU AUDIO: route restore refused/uncertain (state %d); mapping memory retained\n",
+		    error);
+	}
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+	return error == SWEET_SMMU_AUDIO_OK ? 0 :
+	    (error == SWEET_SMMU_AUDIO_EBUSY ? EBUSY : EIO);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_smmu_audio_private.h b/bsd/dev/sweet_smmu_audio_private.h
new file mode 100644
index 0000000..23d4da5
--- /dev/null
+++ b/bsd/dev/sweet_smmu_audio_private.h
@@ -0,0 +1,461 @@
+#ifndef _SWEET_SMMU_AUDIO_PRIVATE_H_
+#define _SWEET_SMMU_AUDIO_PRIVATE_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define SWEET_SMMU_AUDIO_SID                 0x1821u
+#define SWEET_SMMU_AUDIO_IOVA                0x10000000ULL
+#define SWEET_SMMU_AUDIO_MAP_BYTES           20480u
+#define SWEET_SMMU_AUDIO_PAGE_BYTES          4096u
+#define SWEET_SMMU_AUDIO_PAGE_COUNT          5u
+#define SWEET_SMMU_AUDIO_MAX_SMRS            128u
+#define SWEET_SMMU_AUDIO_MAX_CONTEXT_BANKS   128u
+
+#define SWEET_SMMU_AUDIO_ID0                 0x20u
+#define SWEET_SMMU_AUDIO_ID1                 0x24u
+#define SWEET_SMMU_AUDIO_SCR0                0x00u
+#define SWEET_SMMU_AUDIO_SMR(i)              (0x800u + 4u * (uint32_t)(i))
+#define SWEET_SMMU_AUDIO_S2CR(i)             (0xc00u + 4u * (uint32_t)(i))
+#define SWEET_SMMU_AUDIO_GR1                0x1000u
+#define SWEET_SMMU_AUDIO_CBAR(i)             (SWEET_SMMU_AUDIO_GR1 + 4u * (uint32_t)(i))
+#define SWEET_SMMU_AUDIO_CBA2R(i)            (SWEET_SMMU_AUDIO_GR1 + 0x800u + 4u * (uint32_t)(i))
+#define SWEET_SMMU_AUDIO_CB_BASE             0x40000u
+#define SWEET_SMMU_AUDIO_CB(i, reg)          (SWEET_SMMU_AUDIO_CB_BASE + 0x1000u * (uint32_t)(i) + (uint32_t)(reg))
+
+#define SWEET_SMMU_AUDIO_CB_SCTLR            0x000u
+#define SWEET_SMMU_AUDIO_CB_ACTLR            0x004u
+#define SWEET_SMMU_AUDIO_CB_TCR2             0x010u
+#define SWEET_SMMU_AUDIO_CB_TTBR0            0x020u
+#define SWEET_SMMU_AUDIO_CB_TTBR1            0x028u
+#define SWEET_SMMU_AUDIO_CB_TCR              0x030u
+#define SWEET_SMMU_AUDIO_CB_CONTEXTIDR       0x034u
+#define SWEET_SMMU_AUDIO_CB_MAIR0            0x038u
+#define SWEET_SMMU_AUDIO_CB_MAIR1            0x03cu
+#define SWEET_SMMU_AUDIO_CB_TLBIALL          0x618u
+#define SWEET_SMMU_AUDIO_CB_TLBSYNC          0x7f0u
+#define SWEET_SMMU_AUDIO_CB_TLBSTATUS        0x7f4u
+
+#define SWEET_SMMU_AUDIO_SMR_VALID           (1u << 31)
+#define SWEET_SMMU_AUDIO_S2CR_TYPE_MASK      (3u << 16)
+#define SWEET_SMMU_AUDIO_S2CR_TRANSLATE      (0u << 16)
+#define SWEET_SMMU_AUDIO_S2CR_BYPASS         (1u << 16)
+#define SWEET_SMMU_AUDIO_SCR0_CLIENTPD       (1u << 0)
+#define SWEET_SMMU_AUDIO_SCR0_GFIE           (1u << 2)
+#define SWEET_SMMU_AUDIO_SCR0_USFCFG         (1u << 10)
+
+#define SWEET_SMMU_AUDIO_PTE_TABLE           3ULL
+#define SWEET_SMMU_AUDIO_PTE_PAGE_NC         (3ULL | (1ULL << 10) | (2ULL << 8) | (1ULL << 6) | (1ULL << 11))
+#define SWEET_SMMU_AUDIO_PA_LIMIT            (1ULL << 40)
+
+#define SWEET_SMMU_AUDIO_ACK_ASM_CLOSE       (1u << 0)
+#define SWEET_SMMU_AUDIO_ACK_ASM_UNMAP       (1u << 1)
+#define SWEET_SMMU_AUDIO_ACK_ADM_CLOSE       (1u << 2)
+#define SWEET_SMMU_AUDIO_ACK_AFE_STOP        (1u << 3)
+#define SWEET_SMMU_AUDIO_ACK_RESTORE_REQUIRED \
+	(SWEET_SMMU_AUDIO_ACK_ASM_CLOSE | SWEET_SMMU_AUDIO_ACK_ASM_UNMAP | \
+	 SWEET_SMMU_AUDIO_ACK_ADM_CLOSE | SWEET_SMMU_AUDIO_ACK_AFE_STOP)
+
+#define SWEET_SMMU_AUDIO_OK                  0
+#define SWEET_SMMU_AUDIO_EIO                 5
+#define SWEET_SMMU_AUDIO_EBUSY               16
+#define SWEET_SMMU_AUDIO_EEXIST              17
+#define SWEET_SMMU_AUDIO_EINVAL              22
+#define SWEET_SMMU_AUDIO_ENOSPC              28
+
+struct sweet_smmu_audio_io {
+	void *context;
+	uint32_t (*read32)(void *, uint32_t);
+	void (*write32)(void *, uint32_t, uint32_t);
+	void (*write64)(void *, uint32_t, uint64_t);
+};
+
+struct sweet_smmu_audio_saved_cb {
+	uint32_t sctlr;
+	uint32_t actlr;
+	uint32_t tcr2;
+	uint64_t ttbr0;
+	uint64_t ttbr1;
+	uint32_t tcr;
+	uint32_t contextidr;
+	uint32_t mair0;
+	uint32_t mair1;
+	uint32_t cbar;
+	uint32_t cba2r;
+};
+
+struct sweet_smmu_audio_mapping {
+	uint32_t id0;
+	uint32_t id1;
+	uint32_t scr0;
+	unsigned nsmr;
+	unsigned ncb;
+	unsigned smr_index;
+	unsigned cb_index;
+	uint32_t saved_smr;
+	uint32_t saved_s2cr;
+	struct sweet_smmu_audio_saved_cb saved_cb;
+	uint32_t installed_smr;
+	uint32_t installed_s2cr;
+	uint32_t installed_sctlr;
+	uint64_t installed_ttbr0;
+	bool prepared;
+	bool installed;
+	bool uncertain;
+};
+
+static inline uint64_t
+sweet_smmu_audio_read64(const struct sweet_smmu_audio_io *io, uint32_t offset)
+{
+	return io->read32(io->context, offset) |
+	    ((uint64_t)io->read32(io->context, offset + 4u) << 32);
+}
+
+static inline bool
+sweet_smmu_audio_io_valid(const struct sweet_smmu_audio_io *io)
+{
+	return io != NULL && io->read32 != NULL && io->write32 != NULL && io->write64 != NULL;
+}
+
+static inline bool
+sweet_smmu_audio_cb_matches(const struct sweet_smmu_audio_saved_cb *left,
+	const struct sweet_smmu_audio_saved_cb *right)
+{
+	return left->sctlr == right->sctlr && left->actlr == right->actlr &&
+	    left->tcr2 == right->tcr2 && left->ttbr0 == right->ttbr0 &&
+	    left->ttbr1 == right->ttbr1 && left->tcr == right->tcr &&
+	    left->contextidr == right->contextidr && left->mair0 == right->mair0 &&
+	    left->mair1 == right->mair1 && left->cbar == right->cbar &&
+	    left->cba2r == right->cba2r;
+}
+
+/* Snapshot-only selection. Any exact or masked match of SID 0x1821 is owned. */
+static inline int
+sweet_smmu_audio_prepare(const struct sweet_smmu_audio_io *io, uint32_t sid,
+	struct sweet_smmu_audio_mapping *mapping)
+{
+	bool used[SWEET_SMMU_AUDIO_MAX_CONTEXT_BANKS] = { false };
+	unsigned free_smr = SWEET_SMMU_AUDIO_MAX_SMRS;
+	unsigned cb_index = SWEET_SMMU_AUDIO_MAX_CONTEXT_BANKS;
+	uint32_t id0, id1, scr0;
+	unsigned nsmr, ncb, ns2cb;
+
+	if (!sweet_smmu_audio_io_valid(io) || mapping == NULL || sid > 0x7fffu) {
+		return SWEET_SMMU_AUDIO_EINVAL;
+	}
+	id0 = io->read32(io->context, SWEET_SMMU_AUDIO_ID0);
+	id1 = io->read32(io->context, SWEET_SMMU_AUDIO_ID1);
+	scr0 = io->read32(io->context, SWEET_SMMU_AUDIO_SCR0);
+	nsmr = id0 & 0xffu;
+	ncb = id1 & 0xffu;
+	ns2cb = (id1 >> 16) & 0xffu;
+	if (nsmr != 76u || ncb != 45u || id1 != 0x5000002du ||
+	    ns2cb > ncb || (scr0 & SWEET_SMMU_AUDIO_SCR0_CLIENTPD) != 0 ||
+	    (scr0 & (SWEET_SMMU_AUDIO_SCR0_GFIE | SWEET_SMMU_AUDIO_SCR0_USFCFG)) !=
+	    (SWEET_SMMU_AUDIO_SCR0_GFIE | SWEET_SMMU_AUDIO_SCR0_USFCFG)) {
+		return SWEET_SMMU_AUDIO_EINVAL;
+	}
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t smr = io->read32(io->context, SWEET_SMMU_AUDIO_SMR(i));
+		if ((smr & SWEET_SMMU_AUDIO_SMR_VALID) == 0) {
+			if (free_smr == SWEET_SMMU_AUDIO_MAX_SMRS) {
+				free_smr = i;
+			}
+			continue;
+		}
+		uint32_t mask = (smr >> 16) & 0x7fffu;
+		if (((smr ^ sid) & ~mask & 0x7fffu) == 0) {
+			return SWEET_SMMU_AUDIO_EEXIST;
+		}
+	}
+	if (free_smr == SWEET_SMMU_AUDIO_MAX_SMRS) {
+		return SWEET_SMMU_AUDIO_ENOSPC;
+	}
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t s2cr = io->read32(io->context, SWEET_SMMU_AUDIO_S2CR(i));
+		if ((s2cr & SWEET_SMMU_AUDIO_S2CR_TYPE_MASK) != SWEET_SMMU_AUDIO_S2CR_TRANSLATE) {
+			continue;
+		}
+		unsigned referenced_cb = s2cr & 0xffu;
+		if (referenced_cb >= ncb) {
+			return SWEET_SMMU_AUDIO_EINVAL;
+		}
+		used[referenced_cb] = true;
+	}
+	for (unsigned i = ns2cb; i < ncb; i++) {
+		uint32_t sctlr = io->read32(io->context,
+		    SWEET_SMMU_AUDIO_CB(i, SWEET_SMMU_AUDIO_CB_SCTLR));
+		if (!used[i] && (sctlr & 1u) == 0) {
+			cb_index = i;
+			break;
+		}
+	}
+	if (cb_index == SWEET_SMMU_AUDIO_MAX_CONTEXT_BANKS) {
+		return SWEET_SMMU_AUDIO_ENOSPC;
+	}
+	struct sweet_smmu_audio_mapping snapshot = { 0 };
+	snapshot.id0 = id0;
+	snapshot.id1 = id1;
+	snapshot.scr0 = scr0;
+	snapshot.nsmr = nsmr;
+	snapshot.ncb = ncb;
+	snapshot.smr_index = free_smr;
+	snapshot.cb_index = cb_index;
+	snapshot.saved_smr = io->read32(io->context, SWEET_SMMU_AUDIO_SMR(free_smr));
+	snapshot.saved_s2cr = io->read32(io->context, SWEET_SMMU_AUDIO_S2CR(free_smr));
+	snapshot.saved_cb.sctlr = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_SCTLR));
+	snapshot.saved_cb.actlr = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_ACTLR));
+	snapshot.saved_cb.tcr2 = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_TCR2));
+	snapshot.saved_cb.ttbr0 = sweet_smmu_audio_read64(io,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_TTBR0));
+	snapshot.saved_cb.ttbr1 = sweet_smmu_audio_read64(io,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_TTBR1));
+	snapshot.saved_cb.tcr = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_TCR));
+	snapshot.saved_cb.contextidr = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_CONTEXTIDR));
+	snapshot.saved_cb.mair0 = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_MAIR0));
+	snapshot.saved_cb.mair1 = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_MAIR1));
+	snapshot.saved_cb.cbar = io->read32(io->context, SWEET_SMMU_AUDIO_CBAR(cb_index));
+	snapshot.saved_cb.cba2r = io->read32(io->context, SWEET_SMMU_AUDIO_CBA2R(cb_index));
+	snapshot.prepared = true;
+	*mapping = snapshot;
+	return SWEET_SMMU_AUDIO_OK;
+}
+
+static inline bool
+sweet_smmu_audio_wait_tlb(const struct sweet_smmu_audio_io *io, unsigned cb_index)
+{
+	uint32_t status = SWEET_SMMU_AUDIO_CB(cb_index, SWEET_SMMU_AUDIO_CB_TLBSTATUS);
+	for (unsigned i = 0; i < 10000u; i++) {
+		if ((io->read32(io->context, status) & 1u) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static inline bool
+sweet_smmu_audio_write_cb(const struct sweet_smmu_audio_io *io,
+	const struct sweet_smmu_audio_mapping *mapping, uint64_t ttbr0)
+{
+	unsigned cb = mapping->cb_index;
+	uint32_t cb_offset = SWEET_SMMU_AUDIO_CB(cb, 0);
+	uint32_t cbar = (1u << 16) | (0xfu << 12) | (3u << 8);
+	uint32_t tcr2 = (7u << 15) | 2u;
+	uint32_t tcr = 25u | (1u << 23);
+	uint32_t sctlr = (1u << 6) | (1u << 5) | (1u << 2) | (1u << 1) | 1u;
+
+	io->write32(io->context, SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_SCTLR), 0);
+	io->write32(io->context, SWEET_SMMU_AUDIO_CBA2R(cb), 1u);
+	io->write32(io->context, SWEET_SMMU_AUDIO_CBAR(cb), cbar);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR2, tcr2);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR, tcr);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_CONTEXTIDR, cb);
+	io->write64(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR0,
+	    ttbr0 | ((uint64_t)cb << 48));
+	io->write64(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR1, 0);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR0, 0x44u);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR1, 0);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_ACTLR, 0);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TLBIALL, 0);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TLBSYNC, 0);
+	if (!sweet_smmu_audio_wait_tlb(io, cb)) {
+		return false;
+	}
+	io->write32(io->context, SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_SCTLR), sctlr);
+	return io->read32(io->context, SWEET_SMMU_AUDIO_CBA2R(cb)) == 1u &&
+	    io->read32(io->context, SWEET_SMMU_AUDIO_CBAR(cb)) == cbar &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR2) == tcr2 &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR) == tcr &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_CONTEXTIDR) == cb &&
+	    sweet_smmu_audio_read64(io, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR0) ==
+	    (ttbr0 | ((uint64_t)cb << 48)) &&
+	    sweet_smmu_audio_read64(io, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR1) == 0 &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR0) == 0x44u &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR1) == 0 &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_ACTLR) == 0 &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_SCTLR) == sctlr;
+}
+
+static inline bool
+sweet_smmu_audio_write_saved_cb(const struct sweet_smmu_audio_io *io,
+	const struct sweet_smmu_audio_mapping *mapping)
+{
+	unsigned cb = mapping->cb_index;
+	uint32_t cb_offset = SWEET_SMMU_AUDIO_CB(cb, 0);
+	const struct sweet_smmu_audio_saved_cb *saved = &mapping->saved_cb;
+
+	io->write32(io->context, SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_SCTLR), 0);
+	io->write32(io->context, SWEET_SMMU_AUDIO_CBA2R(cb), saved->cba2r);
+	io->write32(io->context, SWEET_SMMU_AUDIO_CBAR(cb), saved->cbar);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_ACTLR, saved->actlr);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR2, saved->tcr2);
+	io->write64(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR0, saved->ttbr0);
+	io->write64(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR1, saved->ttbr1);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR, saved->tcr);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_CONTEXTIDR, saved->contextidr);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR0, saved->mair0);
+	io->write32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR1, saved->mair1);
+	io->write32(io->context, SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_SCTLR), saved->sctlr);
+	return io->read32(io->context, SWEET_SMMU_AUDIO_CBA2R(cb)) == saved->cba2r &&
+	    io->read32(io->context, SWEET_SMMU_AUDIO_CBAR(cb)) == saved->cbar &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_SCTLR) == saved->sctlr &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_ACTLR) == saved->actlr &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR2) == saved->tcr2 &&
+	    sweet_smmu_audio_read64(io, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR0) == saved->ttbr0 &&
+	    sweet_smmu_audio_read64(io, cb_offset + SWEET_SMMU_AUDIO_CB_TTBR1) == saved->ttbr1 &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_TCR) == saved->tcr &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_CONTEXTIDR) == saved->contextidr &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR0) == saved->mair0 &&
+	    io->read32(io->context, cb_offset + SWEET_SMMU_AUDIO_CB_MAIR1) == saved->mair1;
+}
+
+static inline int
+sweet_smmu_audio_install(const struct sweet_smmu_audio_io *io, uint32_t sid,
+	struct sweet_smmu_audio_mapping *mapping, uint64_t l1_pa)
+{
+	struct sweet_smmu_audio_mapping current = { 0 };
+	if (!sweet_smmu_audio_io_valid(io) || mapping == NULL || !mapping->prepared ||
+	    mapping->installed || mapping->uncertain || sid > 0x7fffu ||
+	    l1_pa == 0 || (l1_pa & (SWEET_SMMU_AUDIO_PAGE_BYTES - 1u)) != 0 ||
+	    l1_pa >= SWEET_SMMU_AUDIO_PA_LIMIT) {
+		return SWEET_SMMU_AUDIO_EINVAL;
+	}
+	int error = sweet_smmu_audio_prepare(io, sid, &current);
+	if (error != SWEET_SMMU_AUDIO_OK) {
+		return error;
+	}
+	if (current.id0 != mapping->id0 || current.id1 != mapping->id1 ||
+	    current.scr0 != mapping->scr0 || current.smr_index != mapping->smr_index ||
+	    current.cb_index != mapping->cb_index || current.saved_smr != mapping->saved_smr ||
+	    current.saved_s2cr != mapping->saved_s2cr ||
+	    !sweet_smmu_audio_cb_matches(&current.saved_cb, &mapping->saved_cb)) {
+		return SWEET_SMMU_AUDIO_EBUSY;
+	}
+	mapping->uncertain = true;
+	if (!sweet_smmu_audio_write_cb(io, mapping, l1_pa)) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	mapping->installed_s2cr = SWEET_SMMU_AUDIO_S2CR_TRANSLATE | mapping->cb_index;
+	mapping->installed_smr = SWEET_SMMU_AUDIO_SMR_VALID | sid;
+	mapping->installed_sctlr = io->read32(io->context,
+	    SWEET_SMMU_AUDIO_CB(mapping->cb_index, SWEET_SMMU_AUDIO_CB_SCTLR));
+	mapping->installed_ttbr0 = sweet_smmu_audio_read64(io,
+	    SWEET_SMMU_AUDIO_CB(mapping->cb_index, SWEET_SMMU_AUDIO_CB_TTBR0));
+	io->write32(io->context, SWEET_SMMU_AUDIO_S2CR(mapping->smr_index), mapping->installed_s2cr);
+	if (io->read32(io->context, SWEET_SMMU_AUDIO_S2CR(mapping->smr_index)) != mapping->installed_s2cr) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	io->write32(io->context, SWEET_SMMU_AUDIO_SMR(mapping->smr_index), mapping->installed_smr);
+	if (io->read32(io->context, SWEET_SMMU_AUDIO_SMR(mapping->smr_index)) != mapping->installed_smr) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	mapping->installed = true;
+	mapping->uncertain = false;
+	return SWEET_SMMU_AUDIO_OK;
+}
+
+static inline int
+sweet_smmu_audio_restore(const struct sweet_smmu_audio_io *io,
+	struct sweet_smmu_audio_mapping *mapping, unsigned ack_mask)
+{
+	if (!sweet_smmu_audio_io_valid(io) || mapping == NULL || !mapping->prepared ||
+	    !mapping->installed ||
+	    (ack_mask & SWEET_SMMU_AUDIO_ACK_RESTORE_REQUIRED) != SWEET_SMMU_AUDIO_ACK_RESTORE_REQUIRED) {
+		return SWEET_SMMU_AUDIO_EBUSY;
+	}
+	unsigned cb = mapping->cb_index;
+	uint32_t cb_sctlr = SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_SCTLR);
+	uint32_t cb_ttbr0 = SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_TTBR0);
+	if (io->read32(io->context, SWEET_SMMU_AUDIO_SMR(mapping->smr_index)) != mapping->installed_smr ||
+	    io->read32(io->context, SWEET_SMMU_AUDIO_S2CR(mapping->smr_index)) != mapping->installed_s2cr ||
+	    io->read32(io->context, cb_sctlr) != mapping->installed_sctlr ||
+	    sweet_smmu_audio_read64(io, cb_ttbr0) != mapping->installed_ttbr0) {
+		return SWEET_SMMU_AUDIO_EBUSY;
+	}
+	mapping->uncertain = true;
+	io->write32(io->context, SWEET_SMMU_AUDIO_SMR(mapping->smr_index),
+	    mapping->saved_smr & ~SWEET_SMMU_AUDIO_SMR_VALID);
+	if (io->read32(io->context, SWEET_SMMU_AUDIO_SMR(mapping->smr_index)) !=
+	    (mapping->saved_smr & ~SWEET_SMMU_AUDIO_SMR_VALID)) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	io->write32(io->context, cb_sctlr, 0);
+	if ((io->read32(io->context, cb_sctlr) & 1u) != 0) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	io->write32(io->context, SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_TLBIALL), 0);
+	io->write32(io->context, SWEET_SMMU_AUDIO_CB(cb, SWEET_SMMU_AUDIO_CB_TLBSYNC), 0);
+	if (!sweet_smmu_audio_wait_tlb(io, cb) || !sweet_smmu_audio_write_saved_cb(io, mapping)) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	io->write32(io->context, SWEET_SMMU_AUDIO_S2CR(mapping->smr_index), mapping->saved_s2cr);
+	if (io->read32(io->context, SWEET_SMMU_AUDIO_S2CR(mapping->smr_index)) != mapping->saved_s2cr) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	io->write32(io->context, SWEET_SMMU_AUDIO_SMR(mapping->smr_index), mapping->saved_smr);
+	if (io->read32(io->context, SWEET_SMMU_AUDIO_SMR(mapping->smr_index)) != mapping->saved_smr) {
+		return SWEET_SMMU_AUDIO_EIO;
+	}
+	mapping->installed = false;
+	mapping->prepared = false;
+	mapping->uncertain = false;
+	return SWEET_SMMU_AUDIO_OK;
+}
+
+static inline int
+sweet_smmu_audio_build_tables(uint64_t *l1, uint64_t l1_pa, uint64_t *l2,
+	uint64_t l2_pa, uint64_t *l3, uint64_t l3_pa, uint64_t iova,
+	uint64_t buffer_pa, size_t bytes)
+{
+	if (l1 == NULL || l2 == NULL || l3 == NULL || iova != SWEET_SMMU_AUDIO_IOVA ||
+	    bytes != SWEET_SMMU_AUDIO_MAP_BYTES ||
+	    (buffer_pa & (SWEET_SMMU_AUDIO_PAGE_BYTES - 1u)) != 0 ||
+	    (l1_pa & (SWEET_SMMU_AUDIO_PAGE_BYTES - 1u)) != 0 ||
+	    (l2_pa & (SWEET_SMMU_AUDIO_PAGE_BYTES - 1u)) != 0 ||
+	    (l3_pa & (SWEET_SMMU_AUDIO_PAGE_BYTES - 1u)) != 0 ||
+	    l1_pa == l2_pa || l1_pa == l3_pa || l2_pa == l3_pa ||
+	    l1_pa >= SWEET_SMMU_AUDIO_PA_LIMIT || l2_pa >= SWEET_SMMU_AUDIO_PA_LIMIT ||
+	    l3_pa >= SWEET_SMMU_AUDIO_PA_LIMIT || buffer_pa >= SWEET_SMMU_AUDIO_PA_LIMIT ||
+	    bytes > SWEET_SMMU_AUDIO_PA_LIMIT - buffer_pa) {
+		return SWEET_SMMU_AUDIO_EINVAL;
+	}
+	for (unsigned i = 0; i < 512; i++) {
+		l1[i] = 0;
+		l2[i] = 0;
+		l3[i] = 0;
+	}
+	unsigned l1_index = (unsigned)((iova >> 30) & 0x1ffu);
+	unsigned l2_index = (unsigned)((iova >> 21) & 0x1ffu);
+	unsigned l3_index = (unsigned)((iova >> 12) & 0x1ffu);
+	l1[l1_index] = l2_pa | SWEET_SMMU_AUDIO_PTE_TABLE;
+	l2[l2_index] = l3_pa | SWEET_SMMU_AUDIO_PTE_TABLE;
+	for (unsigned i = 0; i < SWEET_SMMU_AUDIO_PAGE_COUNT; i++) {
+		l3[l3_index + i] = (buffer_pa + ((uint64_t)i * SWEET_SMMU_AUDIO_PAGE_BYTES)) |
+		    SWEET_SMMU_AUDIO_PTE_PAGE_NC;
+	}
+	return SWEET_SMMU_AUDIO_OK;
+}
+
+static inline int
+sweet_smmu_audio_encode_q6asm_address(uint64_t iova, uint64_t *encoded)
+{
+	if (encoded == NULL || iova < SWEET_SMMU_AUDIO_IOVA ||
+	    iova >= SWEET_SMMU_AUDIO_IOVA + SWEET_SMMU_AUDIO_MAP_BYTES) {
+		return SWEET_SMMU_AUDIO_EINVAL;
+	}
+	*encoded = (1ULL << 32) | iova;
+	return SWEET_SMMU_AUDIO_OK;
+}
+
+int sweet_smmu_audio_map_buffer(uintptr_t buffer_va, size_t bytes, uint64_t *iova);
+int sweet_smmu_audio_restore_mapping(unsigned ack_mask);
