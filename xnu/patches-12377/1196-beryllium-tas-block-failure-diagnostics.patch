@@ -3483,6 +3483,13 @@ adsp_apr_linux_afe_mode5_start(void)
 
 struct adsp_tas_i2c_context {
 	vm_offset_t gpio;
+	uint32_t operation_count;
+	uint8_t last_address;
+	uint8_t last_register;
+	uint8_t last_write_value;
