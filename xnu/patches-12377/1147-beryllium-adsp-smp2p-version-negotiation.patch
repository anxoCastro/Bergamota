+static void
+adsp_smp2p_negotiate_remote(void)
+{
+	uint32_t magic, local_head, pids, counts;
+	uint16_t total, valid;
+	uint8_t local_version, local_features;
+	uint32_t entry;
+	char name[17];
+	enum beryllium_smp2p_action action;
+
+	if (!adsp_smp2p_out_valid || !adsp_smp2p_header_valid ||
+	    adsp_smem == NULL || adsp_smp2p_negotiated ||
+	    adsp_smp2p_negotiation_failed) {
+		return;
+	}
+	if (adsp_smp2p_out_data_size < ADSP_SMP2P_HEADER_BYTES + ADSP_SMP2P_ENTRY_BYTES) {
+		printf("SWEET ADSP: SMP2P negotiation refused undersized AP item %u\n",
+		    ADSP_SMP2P_OUT_ITEM);
+		adsp_smp2p_negotiation_failed = true;
+		return;
+	}
+
+	__asm__ volatile ("dmb sy" ::: "memory");
+	magic = adsp_smem_rd32(adsp_smp2p_out_data_off);
+	local_head = adsp_smem_rd32(adsp_smp2p_out_data_off + 4);
+	pids = adsp_smem_rd32(adsp_smp2p_out_data_off + 8);
+	counts = adsp_smem_rd32(adsp_smp2p_out_data_off + 12);
+	total = (uint16_t)counts;
+	valid = (uint16_t)(counts >> 16);
+	local_version = (uint8_t)local_head;
+	local_features = (uint8_t)(local_head >> 8);
+	if (magic != ADSP_SMP2P_MAGIC ||
+	    (uint16_t)pids != ADSP_LOCAL_PID ||
+	    (uint16_t)(pids >> 16) != ADSP_REMOTE_PID ||
+	    local_version == 0 || local_version > ADSP_SMP2P_VERSION ||
+	    total != ADSP_SMP2P_MAX_ENTRY || valid != 1 ||
+	    adsp_smp2p_out_data_size < ADSP_SMP2P_HEADER_BYTES +
+	    (uint32_t)valid * ADSP_SMP2P_ENTRY_BYTES) {
+		printf("SWEET ADSP: SMP2P negotiation refused malformed AP item %u\n",
+		    ADSP_SMP2P_OUT_ITEM);
+		adsp_smp2p_negotiation_failed = true;
+		return;
+	}
+	entry = adsp_smp2p_out_data_off + ADSP_SMP2P_HEADER_BYTES;
+	for (unsigned i = 0; i < 16; i++) {
+		uint8_t ch = adsp_smem[entry + i];
+		name[i] = ch == 0 ? '\0' : ((ch >= 0x20 && ch <= 0x7e) ? (char)ch : '?');
+	}
+	name[16] = '\0';
+	if (strcmp(name, "master-kernel") != 0) {
+		printf("SWEET ADSP: SMP2P negotiation refused AP item without master-kernel\n");
+		adsp_smp2p_negotiation_failed = true;
+		return;
+	}
+
+	if (adsp_smp2p_out_kick_pending) {
+		if (!adsp_smp2p_kick()) {
+			if (!adsp_smp2p_kick_failure_reported) {
+				printf("SWEET ADSP: SMP2P version-downgrade mailbox kick still pending\n");
+				adsp_smp2p_kick_failure_reported = true;
+			}
+			return;
+		}
+		adsp_smp2p_out_kick_pending = false;
+		printf("SWEET ADSP: SMP2P version-downgrade mailbox kick completed\n");
+	}
+
+	uint32_t remote_head = (uint32_t)adsp_remote_smp2p_version |
+	    ((uint32_t)adsp_remote_smp2p_features << 8);
+	uint32_t old_head = local_head;
+	action = beryllium_smp2p_negotiate_header(&local_head, remote_head);
+	switch (action) {
+	case BERYLLIUM_SMP2P_DOWNGRADE:
+		adsp_smem_wr32(adsp_smp2p_out_data_off + 4, local_head);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		adsp_smp2p_out_kick_pending = true;
+		if (!adsp_smp2p_kick()) {
+			if (!adsp_smp2p_kick_failure_reported) {
+				printf("SWEET ADSP: SMP2P item %u version lowered %u->%u; mailbox kick pending\n",
+				    ADSP_SMP2P_OUT_ITEM, (unsigned)(uint8_t)old_head,
+				    (unsigned)(uint8_t)local_head);
+				adsp_smp2p_kick_failure_reported = true;
+			}
+			return;
+		}
+		adsp_smp2p_out_kick_pending = false;
+		printf("SWEET ADSP: SMP2P item %u version lowered %u->%u; mailbox bit %u kicked\n",
+		    ADSP_SMP2P_OUT_ITEM, (unsigned)(uint8_t)old_head,
+		    (unsigned)(uint8_t)local_head, ADSP_SMP2P_DOORBELL);
+		return;
+	case BERYLLIUM_SMP2P_FEATURES_CHANGED:
+		adsp_smem_wr32(adsp_smp2p_out_data_off + 4, local_head);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		adsp_smp2p_negotiated = true;
+		printf("SWEET ADSP: SMP2P features intersected local=%#x remote=%#x common=%#x at version %u\n",
+		    (unsigned)local_features, (unsigned)adsp_remote_smp2p_features,
+		    (unsigned)(uint8_t)(local_head >> 8), (unsigned)(uint8_t)local_head);
+		return;
+	case BERYLLIUM_SMP2P_COMPLETE:
+		adsp_smp2p_negotiated = true;
+		printf("SWEET ADSP: SMP2P version negotiation complete version %u features=%#x\n",
+		    (unsigned)(uint8_t)local_head, (unsigned)(uint8_t)(local_head >> 8));
+		return;
+	case BERYLLIUM_SMP2P_WAIT_REMOTE:
+		if (!adsp_smp2p_remote_version_wait_reported) {
+			printf("SWEET ADSP: SMP2P remote version %u exceeds local %u; AP item unchanged\n",
+			    (unsigned)adsp_remote_smp2p_version, (unsigned)local_version);
+			adsp_smp2p_remote_version_wait_reported = true;
+		}
+		return;
+	case BERYLLIUM_SMP2P_INVALID:
+	default:
+		printf("SWEET ADSP: SMP2P version negotiation refused invalid versions local=%u remote=%u\n",
+		    (unsigned)local_version, (unsigned)adsp_remote_smp2p_version);
+		adsp_smp2p_negotiation_failed = true;
+		return;
+	}
+}
