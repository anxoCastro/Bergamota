diff --git a/bsd/dev/beryllium_smp2p_negotiation.h b/bsd/dev/beryllium_smp2p_negotiation.h
new file mode 100644
index 0000000..b229108
--- /dev/null
+++ b/bsd/dev/beryllium_smp2p_negotiation.h
@@ -0,0 +1,60 @@
+#ifndef BERYLLIUM_SMP2P_NEGOTIATION_H
+#define BERYLLIUM_SMP2P_NEGOTIATION_H
+
+#include <stdint.h>
+
+#define BERYLLIUM_SMP2P_VERSION_MASK 0x000000ffu
+#define BERYLLIUM_SMP2P_FEATURE_MASK 0x0000ff00u
+#define BERYLLIUM_SMP2P_MAX_VERSION  2u
+
+enum beryllium_smp2p_action {
+	BERYLLIUM_SMP2P_INVALID = 0,
+	BERYLLIUM_SMP2P_WAIT_REMOTE,
+	BERYLLIUM_SMP2P_DOWNGRADE,
+	BERYLLIUM_SMP2P_FEATURES_CHANGED,
+	BERYLLIUM_SMP2P_COMPLETE,
+};
+
+/*
+ * Negotiate the version/features word in an AP-owned SMP2P header.
+ * A lower remote version downgrades the local header; a higher remote
+ * version never upgrades it. Feature intersection is only valid once both
+ * peers advertise the same version.
+ */
+static inline enum beryllium_smp2p_action
+beryllium_smp2p_negotiate_header(uint32_t *local_head, uint32_t remote_head)
+{
+	uint8_t local_version, remote_version;
+	uint8_t local_features, remote_features, common_features;
+	uint32_t current;
+
+	if (local_head == 0) {
+		return BERYLLIUM_SMP2P_INVALID;
+	}
+	current = *local_head;
+	local_version = (uint8_t)(current & BERYLLIUM_SMP2P_VERSION_MASK);
+	remote_version = (uint8_t)(remote_head & BERYLLIUM_SMP2P_VERSION_MASK);
+	if (local_version == 0 || local_version > BERYLLIUM_SMP2P_MAX_VERSION ||
+	    remote_version == 0 || remote_version > BERYLLIUM_SMP2P_MAX_VERSION) {
+		return BERYLLIUM_SMP2P_INVALID;
+	}
+	if (remote_version < local_version) {
+		*local_head = (current & ~BERYLLIUM_SMP2P_VERSION_MASK) | remote_version;
+		return BERYLLIUM_SMP2P_DOWNGRADE;
+	}
+	if (remote_version > local_version) {
+		return BERYLLIUM_SMP2P_WAIT_REMOTE;
+	}
+
+	local_features = (uint8_t)((current & BERYLLIUM_SMP2P_FEATURE_MASK) >> 8);
+	remote_features = (uint8_t)((remote_head & BERYLLIUM_SMP2P_FEATURE_MASK) >> 8);
+	common_features = local_features & remote_features;
+	if (common_features != local_features) {
+		*local_head = (current & ~BERYLLIUM_SMP2P_FEATURE_MASK) |
+		    ((uint32_t)common_features << 8);
+		return BERYLLIUM_SMP2P_FEATURES_CHANGED;
+	}
+	return BERYLLIUM_SMP2P_COMPLETE;
+}
+
+#endif /* BERYLLIUM_SMP2P_NEGOTIATION_H */
