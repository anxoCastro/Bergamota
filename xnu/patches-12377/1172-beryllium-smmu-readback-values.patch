 	    ((uint64_t)io->read32(io->context, offset + 4u) << 32);
 }
 
+static inline bool
+sweet_smmu_audio_check_readback32(const struct sweet_smmu_audio_io *io,
+	uint32_t offset, uint32_t expected, struct sweet_smmu_audio_readback *readback)
+{
+	uint32_t actual = io->read32(io->context, offset);
+	if (actual == expected) {
+		return true;
+	}
+	if (readback != NULL) {
+		readback->valid = true;
+		readback->offset = offset;
+		readback->expected = expected;
+		readback->actual = actual;
+	}
+	return false;
+}
+
+static inline bool
+sweet_smmu_audio_check_readback64(const struct sweet_smmu_audio_io *io,
+	uint32_t offset, uint64_t expected, struct sweet_smmu_audio_readback *readback)
+{
+	uint64_t actual = sweet_smmu_audio_read64(io, offset);
+	if (actual == expected) {
+		return true;
+	}
+	if (readback != NULL) {
+		readback->valid = true;
+		readback->offset = offset;
+		readback->expected = expected;
+		readback->actual = actual;
+	}
+	return false;
+}
