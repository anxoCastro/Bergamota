+ * Read-only Poco F1 ADSP preflight. No PAS/GLINK/audio state is changed here.
+ */
+#ifndef _BSD_DEV_BERYLLIUM_ADSP_H_
+#define _BSD_DEV_BERYLLIUM_ADSP_H_
+
+#include <sys/types.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+enum beryllium_adsp_state {
+	BERYLLIUM_ADSP_OFF = 0,
+	BERYLLIUM_ADSP_PREFLIGHT,
+	BERYLLIUM_ADSP_SMP2P_READY_OBSERVED,
+	BERYLLIUM_ADSP_SMP2P_NOT_READY,
+	BERYLLIUM_ADSP_FAILED,
+};
+
+void beryllium_adsp_probe(void);
+void beryllium_adsp_firmware_probe(void);
