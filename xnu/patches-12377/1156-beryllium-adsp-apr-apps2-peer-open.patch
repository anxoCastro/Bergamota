diff --git a/bsd/dev/beryllium_adsp_apr_probe.h b/bsd/dev/beryllium_adsp_apr_probe.h
index 56019c0..c9df952 100644
--- a/bsd/dev/beryllium_adsp_apr_probe.h
+++ b/bsd/dev/beryllium_adsp_apr_probe.h
@@ -24,6 +24,8 @@
 #define BERYLLIUM_ADSP_GLINK_SSR_CHANNEL_NAME_BYTES 10u
 #define BERYLLIUM_ADSP_LOOPBACK_CTL_LPASS_CHANNEL_NAME "LOOPBACK_CTL_LPASS"
 #define BERYLLIUM_ADSP_LOOPBACK_CTL_LPASS_CHANNEL_NAME_BYTES 19u
+#define BERYLLIUM_ADSP_APR_APPS2_CHANNEL_NAME "apr_apps2"
+#define BERYLLIUM_ADSP_APR_APPS2_CHANNEL_NAME_BYTES 10u
 #define BERYLLIUM_ADSP_APR_INTENT_BYTES 512u
 #define BERYLLIUM_ADSP_APR_INTENT_COUNT 20u
 #define BERYLLIUM_ADSP_APR_MAX_REMOTE_INTENTS 64u
@@ -261,6 +263,27 @@ beryllium_adsp_apr_loopback_ctl_lpass_open_valid(const uint8_t *frame,
 	return true;
 }
 
+static inline bool
+beryllium_adsp_apr_apps2_open_valid(const uint8_t *frame, size_t frame_bytes,
+	uint16_t remote_channel_id)
+{
+	if (frame == NULL || remote_channel_id == 0 || frame_bytes != 24 ||
+	    beryllium_adsp_apr_get16(frame) != BERYLLIUM_ADSP_GLINK_CMD_OPEN ||
+	    beryllium_adsp_apr_get16(frame + 2) != remote_channel_id ||
+	    beryllium_adsp_apr_get32(frame + 4) !=
+	    BERYLLIUM_ADSP_APR_APPS2_CHANNEL_NAME_BYTES) {
+		return false;
+	}
+	for (size_t i = 0; i < frame_bytes - 8; i++) {
+		uint8_t expected = i < BERYLLIUM_ADSP_APR_APPS2_CHANNEL_NAME_BYTES ?
+		    (uint8_t)BERYLLIUM_ADSP_APR_APPS2_CHANNEL_NAME[i] : 0;
+		if (frame[8 + i] != expected) {
+			return false;
+		}
+	}
+	return true;
+}
