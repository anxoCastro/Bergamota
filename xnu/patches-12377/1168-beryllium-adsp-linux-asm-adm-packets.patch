+static inline bool
+beryllium_adsp_apr_audio_services_available(
+	const struct beryllium_adsp_apr_response *response)
+{
+	uint32_t asm_matches = 0, adm_matches = 0;
+	bool asm_supported = false, adm_supported = false;
+	if (response == NULL || response->service_count >
+	    BERYLLIUM_ADSP_APR_MAX_DATA_BYTES / 12u) {
+		return false;
+	}
+	for (uint32_t i = 0; i < response->service_count; i++) {
+		const struct beryllium_adsp_apr_service_api *service =
+		    &response->services[i];
+		if (service->service_id == BERYLLIUM_ADSP_APR_ASM_SERVICE) {
+			asm_matches++;
+			asm_supported = service->api_version ==
+			    BERYLLIUM_ADSP_APR_ASM_API &&
+			    service->api_branch_version == 0;
+		} else if (service->service_id == BERYLLIUM_ADSP_APR_ADM_SERVICE) {
+			adm_matches++;
+			adm_supported = service->api_version ==
+			    BERYLLIUM_ADSP_APR_ADM_API &&
+			    service->api_branch_version == 0;
+		}
+	}
+	return asm_matches == 1u && asm_supported && adm_matches == 1u &&
+	    adm_supported;
+}
