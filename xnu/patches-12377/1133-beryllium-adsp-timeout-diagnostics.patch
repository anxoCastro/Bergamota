 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
 
+#if defined(SWEET)
+int sweet_gic_spi_snapshot(unsigned int, uint32_t *, uint32_t *, uint32_t *);
+
+int
+sweet_gic_spi_snapshot(unsigned int intid, uint32_t *enabled, uint32_t *pending, uint32_t *active)
+{
+	if (!gicd_base || intid < 32 || intid >= 1020 || enabled == NULL ||
+	    pending == NULL || active == NULL) {
+		return 0;
+	}
+	uint32_t offset = (intid / 32u) * sizeof(uint32_t);
+	uint32_t mask = 1u << (intid % 32u);
+	*enabled = (gicd_read32(0x100u + offset) & mask) != 0;
+	*pending = (gicd_read32(0x200u + offset) & mask) != 0;
+	*active = (gicd_read32(0x300u + offset) & mask) != 0;
+	return 1;
+}
+#endif
