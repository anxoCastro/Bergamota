+static void
+adsp_post_start_diagnostics(const char *stage)
+{
+	uint32_t reason_off = 0, reason_size = 0;
+	uint32_t enabled = 0, pending = 0, active = 0;
+	char reason[129];
+	bool terminated = false;
+
+	printf("SWEET ADSP: read-only post-start snapshot (%s)\n", stage);
+	if (adsp_smem == NULL) {
+		adsp_smem = (volatile uint8_t *)ml_io_map(ADSP_SMEM_PA, ADSP_SMEM_SIZE);
+	}
+	if (adsp_smem == NULL) {
+		printf("SWEET ADSP: crash reason SMEM item %u unavailable (SMEM mapping failed)\n",
+		    ADSP_CRASH_REASON_ITEM);
+	} else if (!adsp_smem_private_item(0xfffeu, 0xfffeu, ADSP_CRASH_REASON_ITEM,
+	    &reason_off, &reason_size) || reason_size == 0) {
+		printf("SWEET ADSP: crash reason SMEM item %u unavailable or empty\n",
+		    ADSP_CRASH_REASON_ITEM);
+	} else {
+		uint32_t count = MIN(reason_size, (uint32_t)sizeof(reason) - 1);
+		__asm__ volatile ("dmb sy" ::: "memory");
+		for (uint32_t i = 0; i < count; i++) {
+			uint8_t ch = adsp_smem[reason_off + i];
+			if (ch == 0) {
+				reason[i] = '\0';
+				terminated = true;
+				break;
+			}
+			reason[i] = (ch >= 0x20 && ch <= 0x7e) ? (char)ch : '.';
+		}
+		if (!terminated) {
+			reason[count] = '\0';
+		}
+		printf("SWEET ADSP: crash reason SMEM item %u size=%u text=\"%s\"%s (snapshot may be stale)\n",
+		    ADSP_CRASH_REASON_ITEM, reason_size, reason,
+		    (!terminated && count < reason_size) ? " [truncated]" : "");
+	}
+	if (sweet_gic_spi_snapshot(ADSP_Q6V5_WDOG_SPI, &enabled, &pending, &active)) {
+		printf("SWEET ADSP: watchdog SPI %u GIC enabled=%u pending=%u active=%u (read-only)\n",
+		    ADSP_Q6V5_WDOG_SPI, enabled, pending, active);
+	} else {
+		printf("SWEET ADSP: watchdog SPI %u GIC snapshot unavailable\n", ADSP_Q6V5_WDOG_SPI);
+	}
+}
