diff --git a/bsd/dev/beryllium_adsp_apr_probe.h b/bsd/dev/beryllium_adsp_apr_probe.h
index 70324ad..428153f 100644
--- a/bsd/dev/beryllium_adsp_apr_probe.h
+++ b/bsd/dev/beryllium_adsp_apr_probe.h
@@ -16,6 +16,8 @@
 #define BERYLLIUM_ADSP_APR_BASIC_RSP_RESULT 0x000110e8u
 #define BERYLLIUM_ADSP_APR_CHANNEL_NAME "apr_audio_svc"
 #define BERYLLIUM_ADSP_APR_CHANNEL_NAME_BYTES 14u
+#define BERYLLIUM_ADSP_FASTRPC_CHANNEL_NAME "fastrpcglink-apps-dsp"
+#define BERYLLIUM_ADSP_FASTRPC_CHANNEL_NAME_BYTES 22u
 #define BERYLLIUM_ADSP_APR_INTENT_BYTES 512u
 #define BERYLLIUM_ADSP_APR_INTENT_COUNT 20u
 #define BERYLLIUM_ADSP_APR_MAX_REMOTE_INTENTS 64u
@@ -176,6 +178,25 @@ beryllium_adsp_apr_open_name_valid(const uint8_t *frame, size_t frame_bytes,
 	return true;
 }
 
+static inline bool
+beryllium_adsp_apr_fastrpc_open_valid(const uint8_t *frame, size_t frame_bytes,
+	uint16_t remote_channel_id)
+{
+	if (frame == NULL || remote_channel_id == 0 || frame_bytes != 32 ||
+	    beryllium_adsp_apr_get16(frame) != BERYLLIUM_ADSP_GLINK_CMD_OPEN ||
+	    beryllium_adsp_apr_get16(frame + 2) != remote_channel_id ||
+	    (beryllium_adsp_apr_get32(frame + 4) & 0xffffu) !=
+	    BERYLLIUM_ADSP_FASTRPC_CHANNEL_NAME_BYTES) {
+		return false;
+	}
+	for (size_t i = 0; i < BERYLLIUM_ADSP_FASTRPC_CHANNEL_NAME_BYTES; i++) {
+		if (frame[8 + i] != (uint8_t)BERYLLIUM_ADSP_FASTRPC_CHANNEL_NAME[i]) {
+			return false;
+		}
+	}
+	return true;
+}
