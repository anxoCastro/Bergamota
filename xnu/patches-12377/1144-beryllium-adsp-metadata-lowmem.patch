+static bool
+adsp_ranges_overlap(uint64_t a_base, uint64_t a_size, uint64_t b_base, uint64_t b_size)
+{
+	if (a_size == 0 || b_size == 0) {
+		return false;
+	}
+	if (a_base > UINT64_MAX - a_size || b_base > UINT64_MAX - b_size) {
+		return true;
+	}
+	return a_base < b_base + b_size && b_base < a_base + a_size;
+}
