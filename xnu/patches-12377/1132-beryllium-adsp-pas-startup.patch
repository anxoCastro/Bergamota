+static bool
+adsp_fw_read_file(const char *path, uint64_t exact_size, void **out, size_t *out_size)
+{
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int error, resid = 0;
+	vfs_context_t ctx;
+	void *copy;
+
+	*out = NULL;
+	*out_size = 0;
+	if (rootvnode == NULLVP || vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0 || vp == NULLVP) {
+		printf("SWEET ADSP: firmware file unavailable: %s\n", path);
+		return false;
+	}
+	ctx = vfs_context_kernel();
+	error = vnode_size(vp, &size, ctx);
+	if (error || size <= 0 || (uint64_t)size > ADSP_FW_MAX_SIZE ||
+	    (exact_size != 0 && (uint64_t)size != exact_size)) {
+		printf("SWEET ADSP: firmware size invalid for %s: %lld expected %llu error %d\n",
+		    path, (long long)size, (unsigned long long)exact_size, error);
+		vnode_put(vp);
+		return false;
+	}
+	copy = kalloc_data((vm_size_t)size, Z_WAITOK | Z_ZERO);
+	if (copy == NULL) {
+		printf("SWEET ADSP: firmware allocation failed for %s (%lld bytes)\n", path, (long long)size);
+		vnode_put(vp);
+		return false;
+	}
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)copy, (int)size, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (error || resid) {
+		printf("SWEET ADSP: firmware read failed for %s (%d, resid %d)\n", path, error, resid);
+		kfree_data(copy, (vm_size_t)size);
+		return false;
+	}
+	*out = copy;
+	*out_size = (size_t)size;
+	return true;
+}
