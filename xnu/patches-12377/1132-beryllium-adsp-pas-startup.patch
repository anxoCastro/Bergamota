+static void
+adsp_fw_release_full_bundle(struct adsp_full_bundle *bundle)
+{
+	for (unsigned i = 0; i < bundle->segment_count; i++) {
+		if (bundle->segments[i].owned_data != NULL) {
+			kfree_data(bundle->segments[i].owned_data, bundle->segments[i].filesz);
+		}
+	}
+	if (bundle->metadata != NULL) {
+		kfree_data(bundle->metadata, bundle->metadata_size);
+	}
+	if (bundle->mdt != NULL) {
+		kfree_data(bundle->mdt, bundle->mdt_size);
+	}
+	memset(bundle, 0, sizeof(*bundle));
+}
