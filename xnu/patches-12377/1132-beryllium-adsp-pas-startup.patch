@@ -428,1 +428,34 @@
+/* Beryllium ADSP RPMH_CXO_CLK uses the xo.lvl ARC resource at exact value 3. */
+int
+sweet_rpmh_xo_enable(void)
+{
+	if (!sweet_board_beryllium()) {
+		return ENXIO;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing XO vote\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_slave("xo.lvl", RH_ARC, &address, NULL, NULL);
+	}
+	if (!error) {
+		const uint32_t value = 3;
+		printf("SWEET RPMH: ADSP xo.lvl ARC %#x value %u\n", address, value);
+		error = rh_cmds(&address, &value, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ADSP xo.lvl vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
