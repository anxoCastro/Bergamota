+bool
+beryllium_qmp_set_adsp_load_state(bool on)
+{
+	if (!sweet_board_beryllium()) {
+		return false;
+	}
+	if (ms.qmp == 0) {
+		ms.qmp = ml_io_map(MSS_QMP_PA, 0x1000);
+	}
+	if (ms.ipc == 0) {
+		ms.ipc = ml_io_map(MSS_APSS_SHARED_PA, 0x1000);
+	}
+	if (ms.qmp == 0 || ms.ipc == 0) {
+		printf("SWEET MSS: ADSP QMP/IPC mapping failed\n");
+		return false;
+	}
+	if (!ms.qmp_open && !ms_qmp_open()) {
+		printf("SWEET MSS: ADSP QMP channel open failed\n");
+		return false;
+	}
+	const char *msg = on ?
+	    "{class: image, res: load_state, name: adsp, val: on}" :
+	    "{class: image, res: load_state, name: adsp, val: off}";
+	return ms_qmp_send(msg);
+}
