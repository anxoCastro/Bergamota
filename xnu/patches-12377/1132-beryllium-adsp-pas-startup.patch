+	uint64_t total_input = 0;
+	bool split = false, hash_from_mdt = false;
+	void *hash_sidecar = NULL;
+	size_t hash_sidecar_size = 0;
+	static const uint32_t four_k = 0x1000u;
+
+	memset(bundle, 0, sizeof(*bundle));
+	bundle->min_addr = UINT64_MAX;
+	if (!adsp_fw_read_file(ADSP_FW_PATH, 0, (void **)&bundle->mdt, &bundle->mdt_size)) {
+		return false;
+	}
+	total_input = bundle->mdt_size;
+	if (!adsp_fw_validate_metadata(bundle->mdt, bundle->mdt_size, bundle->mdt_size)) {
+		goto fail;
+	}
+	phoff = adsp_u32le(bundle->mdt + 28);
+	phnum = adsp_u16le(bundle->mdt + 44);
+	phdrs = bundle->mdt + phoff;
+	bundle->phnum = phnum;
+	if (phnum < 2 || phnum > ADSP_ELF32_MAX_PHDRS || phoff < ADSP_ELF32_EHDR_BYTES ||
+	    !adsp_range(bundle->mdt_size, phoff, (uint64_t)phnum * ADSP_ELF32_PHDR_BYTES) ||
+	    adsp_u32le(phdrs) == ADSP_PT_LOAD) {
+		printf("SWEET ADSP: full MDT program-header prefix is invalid\n");
+		goto fail;
+	}
+	ehdr_size = adsp_u32le(phdrs + 16);
+	for (unsigned i = 1; i < phnum; i++) {
+		const uint8_t *p = phdrs + i * ADSP_ELF32_PHDR_BYTES;
+		if ((adsp_u32le(p + 24) & ADSP_QCOM_MDT_TYPE_MASK) == ADSP_QCOM_MDT_TYPE_HASH) {
+			hash_index = i;
+			hash_size = adsp_u32le(p + 16);
+			break;
+		}
+	}
+	if (hash_index == UINT32_MAX || ehdr_size < ADSP_ELF32_EHDR_BYTES ||
+	    ehdr_size < (uint64_t)phoff + (uint64_t)phnum * ADSP_ELF32_PHDR_BYTES ||
+	    !adsp_range(bundle->mdt_size, 0, ehdr_size) || hash_size == 0 ||
+	    (uint64_t)ehdr_size + hash_size > ADSP_FW_MAX_SIZE) {
+		printf("SWEET ADSP: full MDT has no bounded hash metadata segment\n");
+		goto fail;
+	}
+	bundle->metadata_size = (size_t)ehdr_size + hash_size;
+	bundle->metadata = kalloc_data(bundle->metadata_size, Z_WAITOK | Z_ZERO);
+	if (bundle->metadata == NULL) {
+		printf("SWEET ADSP: PAS metadata allocation failed (%lu bytes)\n", (unsigned long)bundle->metadata_size);
+		goto fail;
+	}
+	memcpy(bundle->metadata, bundle->mdt, ehdr_size);
+	const uint8_t *hash_phdr = phdrs + hash_index * ADSP_ELF32_PHDR_BYTES;
+	uint32_t hash_file_offset = adsp_u32le(hash_phdr + 4);
+	if ((uint64_t)ehdr_size + hash_size == bundle->mdt_size) {
+		/* qcom_mdt_read_metadata(): split MDT stores hashes immediately after the first p_filesz bytes. */
+		hash_offset = ehdr_size;
+		hash_from_mdt = true;
+	} else if (adsp_range(bundle->mdt_size, hash_file_offset, hash_size)) {
+		hash_offset = hash_file_offset;
+		hash_from_mdt = true;
+	} else {
+		char path[sizeof(ADSP_FW_PATH) + 8];
+		snprintf(path, sizeof(path), "/usr/standalone/firmware/sweet/adsp.b%02u", hash_index);
+		if (!adsp_fw_read_file(path, hash_size, &hash_sidecar, &hash_sidecar_size) || hash_sidecar_size != hash_size) {
+			printf("SWEET ADSP: hash sidecar %s is missing or short\n", path);
+			goto fail;
+		}
+		if (total_input + hash_sidecar_size > ADSP_FW_BUNDLE_MAX_SIZE) {
+			printf("SWEET ADSP: firmware input exceeds aggregate size limit\n");
+			goto fail;
+		}
+		total_input += hash_sidecar_size;
+		memcpy(bundle->metadata + ehdr_size, hash_sidecar, hash_size);
+		kfree_data(hash_sidecar, hash_sidecar_size);
+		hash_sidecar = NULL;
+	}
+	if (hash_from_mdt) {
+		if (hash_offset < ehdr_size || !adsp_range(bundle->mdt_size, hash_offset, hash_size)) {
+			printf("SWEET ADSP: hash bytes are outside the MDT file\n");
+			goto fail;
+		}
+		memcpy(bundle->metadata + ehdr_size, bundle->mdt + hash_offset, hash_size);
+	}
+
+	for (unsigned i = 0; i < phnum; i++) {
+		const uint8_t *p = phdrs + i * ADSP_ELF32_PHDR_BYTES;
+		uint32_t type = adsp_u32le(p), file_offset = adsp_u32le(p + 4);
+		uint32_t paddr = adsp_u32le(p + 12), filesz = adsp_u32le(p + 16);
+		uint32_t memsz = adsp_u32le(p + 20), flags = adsp_u32le(p + 24);
+		uint64_t end = (uint64_t)paddr + memsz;
+		if (filesz != 0 && ((uint64_t)file_offset > bundle->mdt_size ||
+		    (uint64_t)file_offset + filesz > bundle->mdt_size)) {
+			split = true;
+		}
+		if (type != ADSP_PT_LOAD || (flags & ADSP_QCOM_MDT_TYPE_MASK) == ADSP_QCOM_MDT_TYPE_HASH || memsz == 0) {
+			continue;
+		}
+		if (filesz > memsz || end > 0x100000000ull || bundle->segment_count == ADSP_ELF32_MAX_PHDRS) {
+			printf("SWEET ADSP: full MDT load segment %u has invalid bounds\n", i);
+			goto fail;
+		}
+		struct adsp_full_segment *seg = &bundle->segments[bundle->segment_count++];
+		seg->index = i;
+		seg->paddr = paddr;
+		seg->filesz = filesz;
+		seg->memsz = memsz;
+		seg->flags = flags;
+		bundle->relocatable |= !!(flags & ADSP_QCOM_MDT_RELOCATABLE);
+		bundle->min_addr = MIN(bundle->min_addr, paddr);
+		bundle->max_addr = MAX(bundle->max_addr, (end + four_k - 1u) & ~((uint64_t)four_k - 1u));
+	}
+	if (bundle->segment_count == 0 || bundle->max_addr <= bundle->min_addr ||
+	    bundle->max_addr - bundle->min_addr > ADSP_PAS_REGION_SIZE) {
+		printf("SWEET ADSP: full MDT image extent does not fit the ADSP carveout\n");
+		goto fail;
+	}
+	if ((!bundle->relocatable &&
+	    (bundle->min_addr < ADSP_PAS_REGION_PA || bundle->max_addr > ADSP_PAS_REGION_PA + ADSP_PAS_REGION_SIZE)) ||
+	    (bundle->relocatable && bundle->min_addr < ADSP_PAS_REGION_PA)) {
+		printf("SWEET ADSP: full MDT image addresses do not fit the Beryllium carveout\n");
+		goto fail;
+	}
+	bundle->split = split;
+	for (unsigned i = 0; i < bundle->segment_count; i++) {
+		struct adsp_full_segment *seg = &bundle->segments[i];
+		uint32_t filesz = seg->filesz;
+		if (filesz == 0) {
+			continue;
+		}
+		if (split) {
+			char path[sizeof(ADSP_FW_PATH) + 8];
+			size_t seg_size = 0;
+			snprintf(path, sizeof(path), "/usr/standalone/firmware/sweet/adsp.b%02u", seg->index);
+			if (!adsp_fw_read_file(path, filesz, &seg->owned_data, &seg_size) || seg_size != filesz) {
+				printf("SWEET ADSP: split segment %u is missing or not exactly p_filesz bytes\n", seg->index);
+				goto fail;
+			}
+			seg->data = seg->owned_data;
+			total_input += filesz;
+			if (total_input > ADSP_FW_BUNDLE_MAX_SIZE) {
+				printf("SWEET ADSP: firmware input exceeds aggregate size limit\n");
+				goto fail;
+			}
+		} else {
+			uint32_t file_offset = adsp_u32le(phdrs + seg->index * ADSP_ELF32_PHDR_BYTES + 4);
+			if (!adsp_range(bundle->mdt_size, file_offset, seg->filesz)) {
+				printf("SWEET ADSP: embedded segment %u lies outside the MDT file\n", seg->index);
+				goto fail;
+			}
+			seg->data = bundle->mdt + file_offset;
+		}
+	}
+	printf("SWEET ADSP: full firmware bundle valid: MDT %lu bytes, %u program headers, %u load segments, %s, extent %#llx+%#llx, metadata %lu bytes\n",
+	    (unsigned long)bundle->mdt_size, bundle->phnum, bundle->segment_count,
+	    split ? "split sidecars exact" : "embedded payloads", (unsigned long long)bundle->min_addr,
+	    (unsigned long long)(bundle->max_addr - bundle->min_addr), (unsigned long)bundle->metadata_size);
+	return true;
+fail:
+	if (hash_sidecar != NULL) {
+		kfree_data(hash_sidecar, hash_sidecar_size);
+	}
+	adsp_fw_release_full_bundle(bundle);
+	return false;
+}
+
+static void
+adsp_scm_smccc(struct adsp_scm_regs *r)
+{
+	register uint64_t x0 __asm__("x0") = r->a[0];
+	register uint64_t x1 __asm__("x1") = r->a[1];
+	register uint64_t x2 __asm__("x2") = r->a[2];
+	register uint64_t x3 __asm__("x3") = r->a[3];
+	register uint64_t x4 __asm__("x4") = r->a[4];
+	register uint64_t x5 __asm__("x5") = r->a[5];
+	register uint64_t x6 __asm__("x6") = r->a[6];
+	register uint64_t x7 __asm__("x7") = 0;
+	__asm__ volatile ("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+	    : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	*r = (struct adsp_scm_regs) { { x0, x1, x2, x3, x4, x5, x6 } };
+}
+
+/* Resume interrupted SIP calls with original x1-x5 and the returned token in x6. */
+static bool
+adsp_scm_call(const struct adsp_scm_regs *initial, bool fast, struct adsp_scm_regs *out)
+{
+	for (unsigned busy = 0; busy <= SCM_BUSY_LIMIT; busy++) {
+		struct adsp_scm_regs call = *initial;
+		for (unsigned resume = 0;; resume++) {
+			adsp_scm_smccc(&call);
+			if ((int32_t)call.a[0] == SCM_INTERRUPTED) {
+				*out = call;
+				if (resume == SCM_RESUME_LIMIT) {
+					printf("SWEET ADSP: SCM interrupted call did not complete\n");
+					return false;
+				}
+				call = *initial;
+				call.a[0] = SCM_INTERRUPTED;
+				call.a[6] = out->a[6];
+				continue;
+			}
+			break;
+		}
+		*out = call;
+		if ((int32_t)out->a[0] != SCM_BUSY) {
+			return true;
+		}
+		if (fast || busy == SCM_BUSY_LIMIT) {
+			printf("SWEET ADSP: SCM busy; refusing further retries\n");
+			return false;
+		}
+		delay(30000);
+	}
+	return false;
+}
+
+static bool
+adsp_scm_call_available(const char *name, uint32_t cmd)
+{
+	struct adsp_scm_regs out;
+	const struct adsp_scm_regs initial = { { SCM_64 | SCM_INFO_AVAIL, 1,
+	    SCM_SIP | 0x0200u | cmd, 0, 0, 0, 0 } };
+	if (!adsp_scm_call(&initial, false, &out)) {
+		printf("SWEET ADSP: SCM availability query failed for %s\n", name);
+		return false;
+	}
+	bool available = (int32_t)out.a[0] == 0 && out.a[1] != 0;
+	printf("SWEET ADSP: SCM PAS %s call available=%u result=%llu\n", name, (unsigned)available,
+	    (unsigned long long)out.a[1]);
+	return available;
+}
+
+static bool
+adsp_scm_pas_supported(void)
+{
+	static const struct { const char *name; uint32_t cmd; } required[] = {
+		{ "INIT_IMAGE", 1 }, { "MEM_SETUP", 2 }, { "AUTH_AND_RESET", 5 },
+		{ "IS_SUPPORTED", 7 },
+	};
+	for (unsigned i = 0; i < sizeof(required) / sizeof(required[0]); i++) {
+		if (!adsp_scm_call_available(required[i].name, required[i].cmd)) {
+			return false;
+		}
+	}
+	struct adsp_scm_regs out = { { 0 } };
+	const struct adsp_scm_regs initial = { { SCM_64 | SCM_SIP | 0x0200u | 7u, 1,
+	    ADSP_PAS_ID, 0, 0, 0, 0 } };
+	if (!adsp_scm_call(&initial, false, &out) || (int32_t)out.a[0] != 0 || out.a[1] == 0) {
+		printf("SWEET ADSP: PAS ID %u is not supported (status %d result %llu)\n", ADSP_PAS_ID,
+		    (int32_t)out.a[0], (unsigned long long)out.a[1]);
+		return false;
+	}
+	printf("SWEET ADSP: PAS ID %u support confirmed\n", ADSP_PAS_ID);
+	return true;
+}
+
+static bool
+adsp_pas_call(const char *name, uint32_t cmd, uint32_t arginfo, uint64_t arg1, uint64_t arg2)
+{
+	struct adsp_scm_regs out;
+	const struct adsp_scm_regs initial = { { SCM_64 | SCM_SIP | 0x0200u | cmd, arginfo,
+	    ADSP_PAS_ID, arg1, arg2, 0, 0 } };
+	printf("SWEET ADSP: SCM PAS %s id=%u args=%#llx/%#llx\n", name, ADSP_PAS_ID,
+	    (unsigned long long)arg1, (unsigned long long)arg2);
+	sweet_log_sync();
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bool completed = adsp_scm_call(&initial, false, &out);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET ADSP: SCM PAS %s completed=%u status=%d result=%d\n", name, (unsigned)completed,
+	    (int32_t)out.a[0], (int32_t)out.a[1]);
+	sweet_log_sync();
+	return completed && (int32_t)out.a[0] == 0 && (int32_t)out.a[1] == 0;
+}
+
+static bool
+adsp_check_carveout_marker(void)
+{
+	DTEntry chosen = NULL;
+	void const *prop = NULL;
+	unsigned size = 0;
+	uint8_t marker[16];
+	uint64_t ram_base = (uint64_t)gPhysBase, ram_size = (uint64_t)gPhysSize;
+	uint64_t ram_end, carveout_end = ADSP_PAS_REGION_PA + ADSP_PAS_REGION_SIZE;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-adsp-region", &prop, &size) != kSuccess || prop == NULL || size != sizeof(marker)) {
+		printf("SWEET ADSP: exact /chosen/sweet-adsp-region marker missing; carveout not mapped\n");
+		return false;
+	}
+	memcpy(marker, prop, sizeof(marker));
+	if (adsp_u64le(marker) != ADSP_PAS_REGION_PA || adsp_u64le(marker + 8) != ADSP_PAS_REGION_SIZE ||
+	    ram_size == 0 || ram_base > UINT64_MAX - ram_size || ADSP_PAS_REGION_PA > UINT64_MAX - ADSP_PAS_REGION_SIZE) {
+		printf("SWEET ADSP: ADT carveout marker or managed RAM bounds invalid\n");
+		return false;
+	}
+	ram_end = ram_base + ram_size;
+	if (ADSP_PAS_REGION_PA < ram_end && ram_base < carveout_end) {
+		printf("SWEET ADSP: ADSP carveout overlaps XNU RAM %#llx+%#llx; refusing PAS\n",
+		    (unsigned long long)ram_base, (unsigned long long)ram_size);
+		return false;
+	}
+	printf("SWEET ADSP: ADT carveout %#llx+%#x disjoint from XNU RAM %#llx+%#llx\n",
+	    ADSP_PAS_REGION_PA, ADSP_PAS_REGION_SIZE, (unsigned long long)ram_base, (unsigned long long)ram_size);
+	return true;
+}
+
+static bool
+adsp_metadata_alloc_contig(const struct adsp_full_bundle *bundle, vm_offset_t *kva_out, uint64_t *pa_out)
+{
+	vm_offset_t kva = 0;
+	vm_size_t size = round_page(bundle->metadata_size);
+	if (kmem_alloc_contig(kernel_map, &kva, size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET ADSP: contiguous PAS metadata allocation failed\n");
+		return false;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	if (pn == 0) {
+		printf("SWEET ADSP: PAS metadata page has no physical address\n");
+		return false;
+	}
+	for (unsigned i = 1; i < size / PAGE_SIZE; i++) {
+		if (pmap_find_phys(kernel_pmap, (addr64_t)(kva + i * PAGE_SIZE)) != pn + i) {
+			printf("SWEET ADSP: PAS metadata pages are not physically contiguous\n");
+			return false;
+		}
+	}
+	memcpy((void *)kva, bundle->metadata, bundle->metadata_size);
+	sweet_dma_sync_va((const void *)kva, size);
+	for (unsigned i = 0; i < size / PAGE_SIZE; i++) {
+		pmap_set_cache_attributes(pn + i, VM_WIMG_WCOMB);
+	}
+	sweet_dma_sync_va((const void *)kva, size);
+	*kva_out = kva;
+	*pa_out = ptoa_64(pn);
+	printf("SWEET ADSP: PAS metadata %lu bytes at PA %#llx, contiguous and non-cacheable\n",
+	    (unsigned long)bundle->metadata_size, (unsigned long long)*pa_out);
+	return true;
+}
+
+static bool
+beryllium_adsp_pas_start(void)
+{
+	struct adsp_full_bundle bundle;
+	vm_offset_t metadata_kva = 0, region = 0;
+	uint64_t metadata_pa = 0;
+	bool qmp_attempted = false, auth_attempted = false, region_mapped = false;
+	bool ready = false, fatal = false, result = false;
+
+	if (!adsp_pas_requested || !sweet_board_beryllium()) {
+		return false;
+	}
+	printf("SWEET ADSP: explicit PAS ID 1 startup requested (sweetadsp=2)\n");
+	/* Re-read the remote-owned item immediately before PAS; never write item 443/429. */
+	adsp_smp2p_readonly_probe(false);
+	if (adsp_smp2p_ambiguous) {
+		printf("SWEET ADSP: conflicting SMP2P state snapshot; refusing PAS reset\n");
+		return false;
+	}
+	if (adsp_remote_ready) {
+		printf("SWEET ADSP: remote ready is already asserted; refusing PAS reset\n");
+		return false;
+	}
+	if (adsp_remote_fatal) {
+		printf("SWEET ADSP: remote fatal is already asserted; refusing PAS reset\n");
+		return false;
+	}
+	if (!adsp_smp2p_known) {
+		printf("SWEET ADSP: physical state unknown; continuing only under explicit sweetadsp=2 request\n");
+	}
+	printf("SWEET ADSP: Q6V5 watchdog SPI 162 is not observed by this stage; no timeout SHUTDOWN will be issued\n");
+	if (!adsp_fw_read_full_bundle(&bundle)) {
+		printf("SWEET ADSP: complete firmware bundle invalid; no PAS call made\n");
+		return false;
+	}
+	if (!adsp_check_carveout_marker()) {
+		goto out;
+	}
+	if (!adsp_scm_pas_supported()) {
+		printf("SWEET ADSP: SCM PAS ID 1 unavailable or unsupported; no PAS call made\n");
+		goto out;
+	}
+	qmp_attempted = true;
+	if (!beryllium_qmp_set_adsp_load_state(true)) {
+		printf("SWEET ADSP: AOSS QMP load_state=on failed\n");
+		goto out;
+	}
+	/* SDM845 RPMH_CXO_CLK uses xo.lvl=3; this vote is retained for the DSP lifetime. */
+	if (sweet_rpmh_xo_enable() != 0) {
+		printf("SWEET ADSP: RPMh xo.lvl=3 vote failed\n");
+		goto out;
+	}
+	if (!adsp_metadata_alloc_contig(&bundle, &metadata_kva, &metadata_pa)) {
+		goto out;
+	}
+	if (!adsp_pas_call("INIT_IMAGE", 1, 0x82, metadata_pa, 0)) {
+		printf("SWEET ADSP: PAS INIT_IMAGE failed\n");
+		goto out;
+	}
+	if (bundle.relocatable && !adsp_pas_call("MEM_SETUP", 2, 3, ADSP_PAS_REGION_PA,
+	    bundle.max_addr - bundle.min_addr)) {
+		printf("SWEET ADSP: PAS MEM_SETUP failed\n");
+		goto out;
+	}
+	region = ml_io_map_wcomb((vm_offset_t)ADSP_PAS_REGION_PA, ADSP_PAS_REGION_SIZE);
+	if (region == 0) {
+		printf("SWEET ADSP: ADSP carveout mapping failed after PAS metadata setup\n");
+		goto out;
+	}
+	region_mapped = true;
+	for (uint32_t off = 0; off < ADSP_PAS_REGION_SIZE; off += sizeof(uint32_t)) {
+		*(volatile uint32_t *)(region + off) = 0;
+	}
+	for (unsigned i = 0; i < bundle.segment_count; i++) {
+		const struct adsp_full_segment *seg = &bundle.segments[i];
+		uint64_t reloc_base = bundle.relocatable ? bundle.min_addr : ADSP_PAS_REGION_PA;
+		uint64_t off = (uint64_t)seg->paddr - reloc_base;
+		if (seg->filesz == 0) {
+			continue;
+		}
+		if (seg->data == NULL || seg->filesz > seg->memsz || off + seg->memsz > ADSP_PAS_REGION_SIZE) {
+			printf("SWEET ADSP: validated segment %u failed final carveout bounds check\n", seg->index);
+			goto out;
+		}
+		uint32_t j = 0;
+		for (; j + sizeof(uint32_t) <= seg->filesz; j += sizeof(uint32_t)) {
+			uint32_t word;
+			memcpy(&word, seg->data + j, sizeof(word));
+			*(volatile uint32_t *)(region + off + j) = word;
+		}
+		for (; j < seg->filesz; j++) {
+			*(volatile uint8_t *)(region + off + j) = seg->data[j];
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ml_io_unmap(region, ADSP_PAS_REGION_SIZE);
+	region = 0;
+	region_mapped = false;
+	auth_attempted = true;
+	if (!adsp_pas_call("AUTH_AND_RESET", 5, 1, 0, 0)) {
+		printf("SWEET ADSP: PAS AUTH_AND_RESET failed; QMP/XO retained because final remote state is unknown\n");
+		goto out;
+	}
+	printf("SWEET ADSP: PAS AUTH_AND_RESET succeeded; polling read-only Q6V5 SMP2P for up to 5 seconds\n");
+	for (unsigned i = 0; i < 500; i++) {
+		adsp_smp2p_readonly_probe(true);
+		if (adsp_remote_fatal) {
+			fatal = true;
+			break;
+		}
+		if (adsp_remote_ready) {
+			ready = true;
+			break;
+		}
+		delay(10000);
+	}
+	if (ready) {
+		printf("SWEET ADSP: Q6V5 ready observed; stopped before GLINK/APR/audio; QMP/XO retained\n");
+		result = true;
+		goto out;
+	}
+	if (fatal) {
+		printf("SWEET ADSP: Q6V5 SMP2P fatal observed after authentication; instance and QMP/XO retained\n");
+		goto out;
+	}
+	printf("SWEET ADSP: Q6V5 ready timeout; watchdog is unobserved, so no SHUTDOWN is issued and QMP/XO remain on\n");
+out:
+	if (region_mapped) {
+		ml_io_unmap(region, ADSP_PAS_REGION_SIZE);
+	}
+	if (qmp_attempted && !auth_attempted) {
+		(void)beryllium_qmp_set_adsp_load_state(false);
+	}
+	adsp_fw_release_full_bundle(&bundle);
+	return result;
 }
 
