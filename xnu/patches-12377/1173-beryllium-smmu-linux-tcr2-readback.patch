+static inline bool
+sweet_smmu_audio_check_readback32_masked(const struct sweet_smmu_audio_io *io,
+	uint32_t offset, uint32_t expected, uint32_t ignored_mask,
+	struct sweet_smmu_audio_readback *readback)
+{
+	uint32_t actual = io->read32(io->context, offset);
+	if ((actual & ~ignored_mask) == (expected & ~ignored_mask)) {
+		return true;
+	}
+	if (readback != NULL) {
+		readback->valid = true;
+		readback->offset = offset;
+		readback->expected = expected;
+		readback->actual = actual;
+	}
+	return false;
+}
