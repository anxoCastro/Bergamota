+static bool
+adsp_crash_reason_read(char *reason, uint32_t *item_size, bool *truncated)
+{
+	uint32_t reason_off = 0, reason_size = 0;
+	uint32_t count;
+	bool terminated = false;
+
+	if (reason == NULL || item_size == NULL || truncated == NULL) {
+		return false;
+	}
+	reason[0] = '\0';
+	*item_size = 0;
+	*truncated = false;
+	if (adsp_smem == NULL) {
+		adsp_smem = (volatile uint8_t *)ml_io_map(ADSP_SMEM_PA, ADSP_SMEM_SIZE);
+	}
+	if (adsp_smem == NULL ||
+	    !adsp_smem_private_item(0xfffeu, 0xfffeu, ADSP_CRASH_REASON_ITEM,
+	    &reason_off, &reason_size) || reason_size == 0) {
+		return false;
+	}
+	count = MIN(reason_size, (uint32_t)128);
+	__asm__ volatile ("dmb sy" ::: "memory");
+	for (uint32_t i = 0; i < count; i++) {
+		uint8_t ch = adsp_smem[reason_off + i];
+		if (ch == 0) {
+			reason[i] = '\0';
+			terminated = true;
+			break;
+		}
+		reason[i] = (ch >= 0x20 && ch <= 0x7e) ? (char)ch : '.';
+	}
+	if (!terminated) {
+		reason[count] = '\0';
+	}
+	*item_size = reason_size;
+	*truncated = !terminated && count < reason_size;
+	return true;
+}
