+	    "PAS plus GLINK-only startup requested; early SMP2P probe remains read-only" :
+	    (adsp_pas_requested ? "PAS startup mode requested; early SMP2P probe remains read-only" :
+	    "read-only preflight (PAS/SMEM writes disabled)"));
 	adsp_smp2p_readonly_probe(false);
 	printf("SWEET ADSP: early SMP2P snapshot complete; state=%u\n", (unsigned)adsp_state);
 }
diff --git a/bsd/dev/beryllium_adsp_glink_start.h b/bsd/dev/beryllium_adsp_glink_start.h
new file mode 100644
index 0000000..b519e8f
--- /dev/null
+++ b/bsd/dev/beryllium_adsp_glink_start.h
@@ -0,0 +1,178 @@
+#ifndef _BERYLLIUM_ADSP_GLINK_START_H_
+#define _BERYLLIUM_ADSP_GLINK_START_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "beryllium_adsp_glink_survey.h"
+
+#define BERYLLIUM_ADSP_GLINK_COMMAND_VERSION 0u
+#define BERYLLIUM_ADSP_GLINK_COMMAND_VERSION_ACK 1u
+#define BERYLLIUM_ADSP_GLINK_VERSION 1u
+#define BERYLLIUM_ADSP_GLINK_TX_RESERVE 16u
+#define BERYLLIUM_ADSP_GLINK_MESSAGE_BYTES 8u
+
+enum beryllium_adsp_glink_packet_result {
+	BERYLLIUM_ADSP_GLINK_PACKET_MALFORMED = 0,
+	BERYLLIUM_ADSP_GLINK_PACKET_VERSION,
+	BERYLLIUM_ADSP_GLINK_PACKET_VERSION_ACK,
+	BERYLLIUM_ADSP_GLINK_PACKET_UNSUPPORTED,
+};
+
+struct beryllium_adsp_glink_message {
+	uint16_t command;
+	uint16_t version;
+	uint32_t features;
+};
+
+static inline bool
+beryllium_adsp_glink_mode_valid(int mode)
+{
+	return mode >= 1 && mode <= 3;
+}
+
+static inline bool
+beryllium_adsp_glink_mode_requests_pas(int mode)
+{
+	return mode == 2 || mode == 3;
+}
+
+static inline bool
+beryllium_adsp_glink_mode_requests_glink(int mode)
+{
+	return mode == 3;
+}
+
+static inline bool
+beryllium_adsp_glink_tx_fifo_size_valid(uint32_t size)
+{
+	return size > BERYLLIUM_ADSP_GLINK_TX_RESERVE + BERYLLIUM_ADSP_GLINK_MESSAGE_BYTES &&
+	    (size & 7u) == 0;
+}
+
+static inline bool
+beryllium_adsp_glink_rx_fifo_size_valid(uint32_t size)
+{
+	return size >= BERYLLIUM_ADSP_GLINK_MESSAGE_BYTES && (size & 7u) == 0;
+}
+
+static inline bool
+beryllium_adsp_glink_indices_zero(const struct beryllium_adsp_glink_indices *indices)
+{
+	return indices != NULL && indices->tx_tail == 0 && indices->tx_head == 0 &&
+	    indices->rx_tail == 0 && indices->rx_head == 0;
+}
+
+static inline bool
+beryllium_adsp_glink_indices_valid(
+    const struct beryllium_adsp_glink_indices *indices,
+    uint32_t tx_size, uint32_t rx_size)
+{
+	if (indices == NULL || !beryllium_adsp_glink_tx_fifo_size_valid(tx_size) ||
+	    !beryllium_adsp_glink_rx_fifo_size_valid(rx_size)) {
+		return false;
+	}
+	return indices->tx_tail < tx_size && indices->tx_head < tx_size &&
+	    indices->rx_tail < rx_size && indices->rx_head < rx_size &&
+	    (indices->tx_tail & 7u) == 0 && (indices->tx_head & 7u) == 0 &&
+	    (indices->rx_tail & 7u) == 0 && (indices->rx_head & 7u) == 0;
+}
+
+static inline bool
+beryllium_adsp_glink_cold_indices_valid(
+	const struct beryllium_adsp_glink_indices *indices,
+	uint32_t tx_size, uint32_t rx_size)
+{
+	return beryllium_adsp_glink_indices_valid(indices, tx_size, rx_size) &&
+	    beryllium_adsp_glink_indices_zero(indices);
+}
+
+/* Return bytes available to TX after the GLINK 16-byte reserve. */
+static inline bool
+beryllium_adsp_glink_ring_available(uint32_t head, uint32_t tail,
+    uint32_t size, uint32_t *available)
+{
+	uint32_t free_bytes;
+	if (available == NULL || !beryllium_adsp_glink_tx_fifo_size_valid(size) ||
+	    head >= size || tail >= size || (head & 7u) != 0 || (tail & 7u) != 0) {
+		return false;
+	}
+	free_bytes = tail <= head ? size - head + tail : tail - head;
+	*available = free_bytes < BERYLLIUM_ADSP_GLINK_TX_RESERVE ? 0 :
+	    free_bytes - BERYLLIUM_ADSP_GLINK_TX_RESERVE;
+	return true;
+}
+
+static inline bool
+beryllium_adsp_glink_ring_used(uint32_t head, uint32_t tail,
+	uint32_t size, uint32_t *used)
+{
+	if (used == NULL || !beryllium_adsp_glink_rx_fifo_size_valid(size) ||
+	    head >= size || tail >= size || (head & 7u) != 0 || (tail & 7u) != 0) {
+		return false;
+	}
+	*used = head >= tail ? head - tail : size - tail + head;
+	return true;
+}
+
+static inline bool
+beryllium_adsp_glink_ring_advance(uint32_t index, uint32_t count,
+    uint32_t size, uint32_t *next)
+{
+	if (next == NULL || size == 0 || (size & 7u) != 0 || index >= size ||
+	    (index & 7u) != 0 || count > size || (count & 7u) != 0) {
+		return false;
+	}
+	if (count >= size - index) {
+		*next = count - (size - index);
+	} else {
+		*next = index + count;
+	}
+	return *next < size;
+}
+
+static inline void
+beryllium_adsp_glink_encode(uint8_t *wire, uint16_t command,
+    uint16_t version, uint32_t features)
+{
+	if (wire == NULL) {
+		return;
+	}
+	wire[0] = (uint8_t)command;
+	wire[1] = (uint8_t)(command >> 8);
+	wire[2] = (uint8_t)version;
+	wire[3] = (uint8_t)(version >> 8);
+	wire[4] = (uint8_t)features;
+	wire[5] = (uint8_t)(features >> 8);
+	wire[6] = (uint8_t)(features >> 16);
+	wire[7] = (uint8_t)(features >> 24);
+}
+
+static inline enum beryllium_adsp_glink_packet_result
+beryllium_adsp_glink_decode(const uint8_t *wire, size_t length,
+    struct beryllium_adsp_glink_message *message)
+{
+	uint16_t command, version;
+	if (wire == NULL || message == NULL || length != BERYLLIUM_ADSP_GLINK_MESSAGE_BYTES) {
+		return BERYLLIUM_ADSP_GLINK_PACKET_MALFORMED;
+	}
+	command = (uint16_t)wire[0] | ((uint16_t)wire[1] << 8);
+	version = (uint16_t)wire[2] | ((uint16_t)wire[3] << 8);
+	message->command = command;
+	message->version = version;
+	message->features = (uint32_t)wire[4] | ((uint32_t)wire[5] << 8) |
+	    ((uint32_t)wire[6] << 16) | ((uint32_t)wire[7] << 24);
+	if (version != BERYLLIUM_ADSP_GLINK_VERSION) {
+		return BERYLLIUM_ADSP_GLINK_PACKET_UNSUPPORTED;
+	}
+	if (command == BERYLLIUM_ADSP_GLINK_COMMAND_VERSION) {
+		return BERYLLIUM_ADSP_GLINK_PACKET_VERSION;
+	}
+	if (command == BERYLLIUM_ADSP_GLINK_COMMAND_VERSION_ACK) {
+		return BERYLLIUM_ADSP_GLINK_PACKET_VERSION_ACK;
+	}
+	return BERYLLIUM_ADSP_GLINK_PACKET_UNSUPPORTED;
+}
+
+#endif /* _BERYLLIUM_ADSP_GLINK_START_H_ */
