+static inline bool
+beryllium_adsp_apr_encode_afe_clock_set(uint8_t *packet,
+	size_t packet_capacity, size_t *packet_bytes, bool enable)
+{
+	if (packet == NULL || packet_bytes == NULL ||
+	    packet_capacity < BERYLLIUM_ADSP_AFE_CLOCK_SET_PACKET_BYTES) {
+		return false;
+	}
+	for (size_t i = 0; i < BERYLLIUM_ADSP_AFE_CLOCK_SET_PACKET_BYTES; i++) {
+		packet[i] = 0;
+	}
+	beryllium_adsp_apr_put16(packet, BERYLLIUM_ADSP_APR_SEQ_CMD_HDR_FIELD);
+	beryllium_adsp_apr_put16(packet + 2,
+	    BERYLLIUM_ADSP_AFE_CLOCK_SET_PACKET_BYTES);
+	packet[4] = BERYLLIUM_ADSP_APR_AFE_SERVICE;
+	packet[5] = BERYLLIUM_ADSP_APR_DOMAIN_APPS;
+	packet[8] = BERYLLIUM_ADSP_APR_AFE_SERVICE;
+	packet[9] = BERYLLIUM_ADSP_APR_DOMAIN_ADSP;
+	beryllium_adsp_apr_put32(packet + 12,
+	    BERYLLIUM_ADSP_AFE_QUAT_MI2S_TOKEN);
+	beryllium_adsp_apr_put32(packet + 16,
+	    BERYLLIUM_ADSP_AFE_CMD_SVC_SET_PARAM);
+	beryllium_adsp_apr_put32(packet + BERYLLIUM_ADSP_APR_HEADER_BYTES, 32u);
+	beryllium_adsp_apr_put32(packet + 36,
+	    BERYLLIUM_ADSP_AFE_MODULE_CLOCK_SET);
+	beryllium_adsp_apr_put32(packet + 40,
+	    BERYLLIUM_ADSP_AFE_PARAM_CLOCK_SET);
+	beryllium_adsp_apr_put16(packet + 44,
+	    BERYLLIUM_ADSP_AFE_CLOCK_SET_CONFIG_BYTES);
+	beryllium_adsp_apr_put32(packet + 48, 1u);
+	beryllium_adsp_apr_put32(packet + 52, 0x106u);
+	beryllium_adsp_apr_put32(packet + 56, enable ? 1536000u : 0u);
+	beryllium_adsp_apr_put16(packet + 60, 1u);
+	beryllium_adsp_apr_put16(packet + 62, 0u);
+	beryllium_adsp_apr_put32(packet + 64, enable ? 1u : 0u);
+	*packet_bytes = BERYLLIUM_ADSP_AFE_CLOCK_SET_PACKET_BYTES;
+	return true;
+}
