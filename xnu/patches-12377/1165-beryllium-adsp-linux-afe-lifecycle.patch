+	}
+	for (size_t i = 0; i < BERYLLIUM_ADSP_AFE_DEVICE_PACKET_BYTES; i++) {
+		packet[i] = 0;
+	}
+	beryllium_adsp_apr_put16(packet, BERYLLIUM_ADSP_APR_SEQ_CMD_HDR_FIELD);
+	beryllium_adsp_apr_put16(packet + 2,
+	    BERYLLIUM_ADSP_AFE_DEVICE_PACKET_BYTES);
+	packet[4] = BERYLLIUM_ADSP_APR_AFE_SERVICE;
+	packet[5] = BERYLLIUM_ADSP_APR_DOMAIN_APPS;
+	packet[8] = BERYLLIUM_ADSP_APR_AFE_SERVICE;
+	packet[9] = BERYLLIUM_ADSP_APR_DOMAIN_ADSP;
+	beryllium_adsp_apr_put32(packet + 12,
+	    BERYLLIUM_ADSP_AFE_QUAT_MI2S_TOKEN);
+	beryllium_adsp_apr_put32(packet + 16, start ?
+	    BERYLLIUM_ADSP_AFE_CMD_DEVICE_START :
+	    BERYLLIUM_ADSP_AFE_CMD_DEVICE_STOP);
+	beryllium_adsp_apr_put16(packet + 20,
+	    BERYLLIUM_ADSP_AFE_PORT_QUAT_MI2S_RX);
+	*packet_bytes = BERYLLIUM_ADSP_AFE_DEVICE_PACKET_BYTES;
+	return true;
+}
