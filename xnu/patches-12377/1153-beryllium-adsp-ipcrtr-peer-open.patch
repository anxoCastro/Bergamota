+static inline bool
+beryllium_adsp_apr_ipcrtr_open_valid(const uint8_t *frame, size_t frame_bytes,
+	uint16_t remote_channel_id)
+{
+	if (frame == NULL || remote_channel_id == 0 || frame_bytes != 16 ||
+	    beryllium_adsp_apr_get16(frame) != BERYLLIUM_ADSP_GLINK_CMD_OPEN ||
+	    beryllium_adsp_apr_get16(frame + 2) != remote_channel_id ||
+	    (beryllium_adsp_apr_get32(frame + 4) & 0xffffu) !=
+	    BERYLLIUM_ADSP_IPCRTR_CHANNEL_NAME_BYTES) {
+		return false;
+	}
+	for (size_t i = 0; i < BERYLLIUM_ADSP_IPCRTR_CHANNEL_NAME_BYTES; i++) {
+		if (frame[8 + i] != (uint8_t)BERYLLIUM_ADSP_IPCRTR_CHANNEL_NAME[i]) {
+			return false;
+		}
+	}
+	return true;
+}
