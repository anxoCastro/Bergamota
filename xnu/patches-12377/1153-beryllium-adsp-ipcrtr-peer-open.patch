 #define BERYLLIUM_ADSP_APR_CHANNEL_NAME_BYTES 14u
 #define BERYLLIUM_ADSP_FASTRPC_CHANNEL_NAME "fastrpcglink-apps-dsp"
 #define BERYLLIUM_ADSP_FASTRPC_CHANNEL_NAME_BYTES 22u
+#define BERYLLIUM_ADSP_IPCRTR_CHANNEL_NAME "IPCRTR"
+#define BERYLLIUM_ADSP_IPCRTR_CHANNEL_NAME_BYTES 7u
 #define BERYLLIUM_ADSP_APR_INTENT_BYTES 512u
 #define BERYLLIUM_ADSP_APR_INTENT_COUNT 20u
 #define BERYLLIUM_ADSP_APR_MAX_REMOTE_INTENTS 64u
